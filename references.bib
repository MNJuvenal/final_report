@article{morita_learning_nodate,
 title = {{LEARNING} {SUPPORT} {FOR} {COMPOSITION} {ABILITY}: {SURFACE} {AND} {STRUCTURAL} {SIMILARITY}},
 abstract = {Composition ability is one of the basic skills in design work, which is the combining of parts to form a whole. This paper introduces a support system helps learners acquire the ability to compose consistent figures. Our system is an application of the model of analogical reasoning. The system presents an example graphic and prompts the learner to compose a novel one. After it calculates scores for the surface and structural similarities of the graphic composed by the learner and the example presented by the system, the system gives the scores to the learner as feedback in order to help the learner extract abstract principles from the presented example. This paper presents the algorithms of the model and the results of experiment that investigate the correspondence between human similarity rating and the scores calculated by the model.},
