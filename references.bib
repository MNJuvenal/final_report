@article{vujosevic-janicic_software_2013,
 title = {Software verification and graph similarity for automated evaluation of students’ assignments},
 volume = {55},
 rights = {https://www.elsevier.com/tdm/userlicense/1.0/},
 issn = {09505849},
 url = {https://linkinghub.elsevier.com/retrieve/pii/S0950584912002406},
 doi = {10.1016/j.infsof.2012.12.005},
 abstract = {In this paper we promote introducing software veriﬁcation and control ﬂow graph similarity measurement in automated evaluation of students’ programs. We present a new grading framework that merges results obtained by combination of these two approaches with results obtained by automated testing, leading to improved quality and precision of automated grading. These two approaches are also useful in providing a comprehensible feedback that can help students to improve the quality of their programs We also present our corresponding tools that are publicly available and open source. The tools are based on {LLVM} low-level intermediate code representation, so they could be applied to a number of programming languages. Experimental evaluation of the proposed grading framework is performed on a corpus of university students’ programs written in programming language C. Results of the experiments show that automatically generated grades are highly correlated with manually determined grades suggesting that the presented tools can ﬁnd real-world applications in studying and grading.},
 pages = {1004--1016},
 number = {6},
 journaltitle = {Information and Software Technology},
 shortjournal = {Information and Software Technology},
 author = {Vujošević-Janičić, Milena and Nikolić, Mladen and Tošić, Dušan and Kuncak, Viktor},
 urldate = {2026-07-09},
 date = {2013-06},
 langid = {english},
 annotation = {Note de lecture
Le contexte et l'objectif
L'évaluation automatisée classique des devoirs de programmation repose presque exclusivement sur des tests fonctionnels (vérification des entrées/sorties). Les auteurs soulignent deux limites majeures à cette approche :


L'incapacité à détecter les "bugs silencieux" : Un programme peut réussir tous les tests fournis mais contenir des failles critiques (dépassement de tampon, pointeur nul, division par zéro) qui le feraient planter dans d'autres conditions.


L'incapacité à évaluer la qualité du code : Les tests ignorent l'architecture. Un code "bricolé" et inefficace obtiendra la même note qu'un code élégant et bien structuré.


Objectif global : Créer un système de correction 100 \% automatisé qui combine les tests classiques avec deux méthodes d'analyse avancées (la vérification logicielle et la similarité de graphes) afin de simuler l'évaluation nuancée d'un professeur humain, tout en fournissant un retour pédagogique détaillé aux étudiants.


Les données : L'étude se base sur 266 copies d'étudiants en langage C, réparties sur 15 exercices différents.


Le point de départ : L'expérience ne retient que les copies ayant déjà passé les tests fonctionnels avec succès. Elles ont donc toutes une note de base de 8 sur 10  soit 80\% de la note(t).



L'objectif : Automatiser la distribution des 2 derniers points (les 20 \% restants). Ces points sont normalement évalués manuellement par le professeur, qui juge la sécurité et l'élégance du code.



Technologie commune : Pour s'affranchir des spécificités du langage de programmation (ici, le langage C), tous les programmes sont d'abord compilés en {LLVM}, un langage intermédiaire de bas niveau.



1. Outil 1 : {LAV} (La traque des bugs silencieux)


{LAV} est un outil qui transforme le code en équations pour prouver mathématiquement l'absence de bugs (dépassements de mémoire, pointeurs nuls).


Pour éviter les "faux positifs" (accuser un élève à tort, ce qui ruinerait la notation), {LAV} effectue une double vérification sur les boucles : une sur-approximation rapide, suivie d'une sous-approximation très stricte si un doute subsiste.


Résultats : Il a trouvé 35 des 36 bugs cachés. Sa fiabilité est de 100 \% (zéro faux positif) et son exhaustivité est de 97 \% (il a raté 1 seul bug, exactement comme le correcteur humain de contrôle).


La note générée (x) : L'outil attribue 1 si le code est totalement sécurisé, et 0 s'il y a un bug.


3. Outil 2 : Les Graphes (L'évaluation de l'architecture)


Le système convertit le code de l'élève et la solution idéale du professeur en Graphes de Flot de Contrôle ({CFG}) pour comparer leur logique.


Le calcul en deux temps :


Amorçage textuel : L'algorithme utilise la distance de Levenshtein pour évaluer la ressemblance brute du texte des instructions.


Structure logique : Il utilise le calcul itératif Neighbor Matching. Le principe est que deux blocs se ressemblent si leurs voisins se ressemblent. Pour comparer efficacement des groupes de voisins de tailles différentes, il s'appuie sur l'Algorithme Hongrois.




Temps de calcul : La complexité mathématique est de O(N{\textasciicircum}3). C'est très rapide ici car les programmes d'étudiants sont courts, mais les chercheurs précisent que cela pourrait être trop lent sur des logiciels géants.


La note générée (n) : L'outil crache un score continu entre 0 et 1 qui évalue la ressemblance architecturale avec la solution du prof.


4. La Synthèse (Le Machine Learning)


Les chercheurs n'ont pas écrit la règle des 80/20 dans leur code.


Ils ont donné les scores bruts des outils à un algorithme de régression linéaire, en lui demandant de retrouver tout seul le barème caché dans la tête des professeurs.


L'équation trouvée : y = 8.043*t + 1.014 *x + 0.934*n


La machine a redécouvert d'elle-même qu'il fallait donner environ 8 points pour les tests , 1 point pour la sécurité  et 1 point pour la structure .


},
 annotation = {Téléchargé le 09072026 parce que cet article semble graviter autour de l’article “Graph semantic similarity-based automatic assessment for programming exercises”

},
 file = {PDF:files/100/Vujošević-Janičić et al. - 2013 - Software verification and graph similarity for automated evaluation of students’ assignments.pdf:application/pdf},
}

@article{messer_automated_2024,
 title = {Automated Grading and Feedback Tools for Programming Education: A Systematic Review},
 volume = {24},
 url = {https://dl.acm.org/doi/10.1145/3636515},
 doi = {10.1145/3636515},
 shorttitle = {Automated Grading and Feedback Tools for Programming Education},
 abstract = {We conducted a systematic literature review on automated grading and feedback tools for programming education. We analysed 121 research papers from 2017 to 2021 inclusive and categorised them based on skills assessed, approach, language paradigm, degree of automation, and evaluation techniques. Most papers assess the correctness of assignments in object-oriented languages. Typically, these tools use a dynamic technique, primarily unit testing, to provide grades and feedback to the students or static analysis techniques to compare a submission with a reference solution or with a set of correct student submissions. However, these techniques’ feedback is often limited to whether the unit tests have passed or failed, the expected and actual output, or how they differ from the reference solution. Furthermore, few tools assess the maintainability, readability, or documentation of the source code, with most using static analysis techniques, such as code quality metrics, in conjunction with grading correctness. Additionally, we found that most tools offered fully automated assessment to allow for near-instantaneous feedback and multiple resubmissions, which can increase student satisfaction and provide them with more opportunities to succeed. In terms of techniques used to evaluate the tools’ performance, most papers primarily use student surveys or compare the automatic assessment tools to grades or feedback provided by human graders. However, because the evaluation dataset is frequently unavailable, it is more difficult to reproduce results and compare tools to a collection of common assignments.},
 pages = {10:1--10:43},
 number = {1},
 journaltitle = {{ACM} Transactions on Computing Education},
 shortjournal = {{ACM} Trans. Comput. Educ.},
 author = {Messer, Marcus and Brown, Neil C. C. and Kölling, Michael and Shi, Miaojing},
 urldate = {2026-07-09},
 date = {2024},
 annotation = {Note de lecture

Le contexte et l'objectif
L'évaluation automatisée classique des devoirs de programmation a fait l'objet d'une littérature abondante, mais dispersée et sans consensus méthodologique. Les auteurs soulignent deux limites majeures aux revues existantes sur le sujet :


L'absence de rigueur systématique — la plupart des revues antérieures (Ihantola et al., Souza et al., Nayak et al.) sélectionnent leurs sources à la main plutôt que par un protocole de recherche reproductible.


L'absence de comparaison face aux correcteurs humains — les revues précédentes cataloguent les techniques utilisées mais analysent rarement en détail si les outils tiennent la comparaison face à une notation manuelle.


Objectif global : produire la première revue véritablement systématique du domaine — protocole {PRISMA}, préenregistrement sur l'Open Science Foundation, deux évaluateurs indépendants — pour cartographier objectivement quelles compétences sont évaluées, par quelles techniques, sur quels langages, avec quel degré d'automatisation, et avec quelle rigueur d'évaluation.


Les données : la revue se base sur 121 papiers de recherche publiés entre 2017 et 2021 inclus, retenus après un entonnoir de sélection partant de 1490 résultats initiaux sur trois bases de données ({ACM} {DL}, {IEEEXplore}, Scopus).


Le point de départ : seuls les outils décrivant une solution achevée sont retenus — les papiers décrivant un outil encore en développement sont explicitement exclus (26 papiers écartés pour cette raison au stade final du criblage).


L'objectif précis : répondre à six questions de recherche portant sur les techniques les plus courantes, les langages ciblés, les compétences évaluées, la performance face à l'humain, la qualité du feedback comparée à l'humain, et les méthodes de feedback dominantes.


Cadre conceptuel commun : pour classer les 121 outils de façon homogène, les auteurs croisent quatre compétences évaluables (correction, maintenabilité, lisibilité, documentation) avec trois catégories d'approches (analyse dynamique, analyse statique, machine learning), en étendant la taxonomie plus ancienne d'Ala-Mutka (2005) qui ne distinguait que dynamique/statique.


Résultat 1 — la correction domine très largement, la similarité n'en est qu'une sous-catégorie marginale
66\% des 121 papiers n'évaluent que la correction — parmi eux, 36\% par tests dynamiques seuls, 17\% par analyse statique seule, 21\% par combinaison des deux, 6\% par {ML}. Les méthodes comparatives par similarité structurelle (conversion en {AST} ou {CFG} pour comparer une soumission à une solution de référence) n'apparaissent que comme sous-catégorie de cette portion statique — loin d'être l'approche dominante du champ.
Résultat 2 — l'hybridation multi-signaux surpasse nettement chaque signal isolé
Wang et al. (2020), sur la notation de requêtes {SQL}, obtiennent une erreur absolue moyenne de 8.37 avec une approche hybride combinant analyse dynamique + similarité {AST} + similarité textuelle — contre 26.01 pour le statique seul, 29.89 pour le texte seul, 21.66 pour le dynamique seul.
Résultat 3 — un problème structurel de reproductibilité
84\% des outils recensés ne publient pas leur jeu de données d'évaluation, rendant la comparaison entre outils et la reproduction des résultats difficile à l'échelle du champ.
Résultat 4 — la comparaison à l'humain reste l'exception, pas la norme
Seulement 22 outils sur 121 sont évalués contre des correcteurs humains (16 pour la note, 6 pour le feedback). La majorité des évaluations reposent plutôt sur des sondages étudiants (24\%) ou une comparaison à la notation manuelle sans protocole statistique poussé (22\%).
Résultat 5 — un résultat qui inverse la charge de la preuve habituelle
Insa \& Silva (2018) : leur test {ANOVA} conclut que ce sont les correcteurs humains, et non l'outil automatique, qui introduisent de la variance dans la notation (p = 0.0164) — un résultat qui va à l'encontre de l'hypothèse implicite que l'automatisation doit prouver sa fiabilité face à un étalon humain supposé stable.

Limites reconnues par les auteurs eux-mêmes


Trois bases de données seulement. Ils ont cherché uniquement sur {IEEEXplore}, {ACM} {DL} et Scopus. Des papiers pertinents publiés ailleurs ont donc pu leur échapper.
. Ils n'ont pas regardé les références citées par leurs 121 papiers pour en trouver d'autres. Ils ont jugé que 121 papiers suffisaient déjà pour avoir une vue d'ensemble correcte, mais ça veut dire qu'ils ont sûrement raté des papiers pertinents qui n'avaient pas les bons mots-clés dans leur titre ou résumé. C'est en partie pour ça que Wang et al. (2007) et Vujošević-Janičić et al. (2013) ne sont pas dans leur revue — même si la vraie raison ici, c'est surtout qu'ils sont trop vieux pour la période choisie (2017-2021).


Une seule personne a fait une partie du travail. Les deux évaluateurs ont lu ensemble tous les papiers en texte intégral. Mais quand il a fallu ajouter des annotations supplémentaires plus tard, une seule personne s'en est chargée, et l'autre a juste relu après coup. Ça laisse un risque d'erreurs ou d'oublis.


Les outils commerciaux sont absents. S'il n'y a pas d'article scientifique qui documente un outil, même si des écoles l'utilisent vraiment, il n'apparaît pas dans la revue.


L'arrivée des {IA} génératives n'est pas couverte. Leur période de recherche (2017-2021) s'arrête avant l'explosion de {ChatGPT} dans l'éducation. Ils citent deux études contradictoires publiées après coup : une qui montre que {ChatGPT} résout facilement les petits exercices simples, une autre qui montre qu'il échoue sur des exercices plus complexes sauf s'il reçoit lui-même le feedback d'un outil de correction automatique. Les auteurs notent juste que ça pourrait remettre en question l'intérêt des petits exercices fermés que la plupart de leurs outils corrigent.



},
 annotation = {Téléchargé le 09072026 dans le cadre de recherche sur l’utilisation de la similarité entre code pour fournir un feedback aux étudiants

},
 file = {Full Text PDF:files/104/Messer et al. - 2024 - Automated Grading and Feedback Tools for Programming Education A Systematic Review.pdf:application/pdf},
}

@inproceedings{reddy_graph-based_2025,
 title = {Graph-Based Semantic Similarity for Programming Exercise Assessment: A Survey},
 url = {https://ieeexplore.ieee.org/abstract/document/11167193},
 doi = {10.1109/CONIT65521.2025.11167193},
 shorttitle = {Graph-Based Semantic Similarity for Programming Exercise Assessment},
 abstract = {In the present knowledge proliferating from computers, it has become a necessity to learn computer programming languages. Competent and proficient programming skills are very important for any computer science student, and to obtain proficiency, learning these skills requires much practice using programming exercises. However, as the sizes of classes continue to increase, assessing the programming exercises manually creates an overwhelming workload for instructors, adding significant amounts of time and culminating in errors in grading. Current tools typically provide feedback by listing failed test cases, but this can be tedious and incomplete. This paper describes a design for an automated assessment tool that evaluates the accuracy of programming assignments, provides grades and counterexamples, and compares with a reference solution. Rather than count the number of tests that were completed, our tool supplies a semantically different execution path between a student’s submission and the reference solution. Index Terms-programming skills, automated assessment, automated grading.},
 eventtitle = {2025 5th International Conference on Intelligent Technologies ({CONIT})},
 pages = {1--8},
 booktitle = {2025 5th International Conference on Intelligent Technologies ({CONIT})},
 author = {Reddy, Manda Uday Kiran and Pujar, Shreyas and Inturi, Srujana},
 urldate = {2026-07-09},
 date = {2025-06},
 keywords = {Accuracy, Computers, Indexes, Programming, Semantics, Surveys},
 annotation = {Note de  lecture

Contexte et objectif
Ce document  Il dresse l'état de l'art des systèmes d'évaluation automatisée pour les exercices de programmation, avec pour objectif de recenser les méthodes qui dépassent la simple vérification par tests unitaires pour aller vers une compréhension sémantique et structurelle du code.
Le problème pointé
L'évaluation manuelle est devenue ingérable à l'échelle — classes surchargées, {MOOCs} à centaines de milliers d'inscrits. Les correcteurs automatisés traditionnels, basés uniquement sur des jeux de tests, présentent deux failles : ils sont laborieux à configurer pour couvrir tous les cas extrêmes, et ils ne jugent pas l'architecture du code — une logique correcte qui ne produit pas exactement la sortie textuelle attendue est pénalisée au même titre qu'une erreur réelle.
Les familles de solutions recensées
Le papier catégorise les approches en quatre familles, dont trois retiennent l'attention pour la suite du travail :
Les méthodes formelles et error models. Générer un feedback fin à partir de spécifications de référence. Coûteux à produire, cette famille reste orthogonale à la question de similarité entre exercices.
Les approches par graphes ({AST} \& {CFG}). Le code étudiant est transformé en arbre syntaxique abstrait ou en graphe de flot de contrôle pour évaluer la similarité logique et structurelle par rapport à la solution du professeur, indépendamment du style d'écriture ou du nom des variables. Limite soulevée par le papier : ces méthodes peinent à gérer la diversité des styles de codage quand les étudiants s'éloignent trop de la structure du code de référence.
Le deep learning ({CodeBERT}, {CodeT}5, réseaux siamois). Des modèles Transformers pré-entraînés vectorisent le code pour en capturer la sémantique profonde. Avantage mis en avant : ces modèles imitent bien le jugement humain et peuvent attribuer des points partiels de façon nuancée. Limite : ils exigent d'énormes jeux de données étiquetés.
Les approches hybrides. Combiner analyse statique (structure du code sans exécution) et analyse dynamique (exécution des tests). Présenté comme le compromis le plus efficace pour un retour pédagogique complet, couvrant à la fois erreurs de logique et erreurs de structure.

Le constat global du papier va dans le sens d'une tendance de fond : la recherche se détourne de l'évaluation binaire au profit de scores de similarité sémantique continus — l'enjeu n'est plus que le code compile, mais comment l'étudiant a résolu le problème. Le défi identifié comme non résolu est la généralisation : la plupart des outils performants restent très dépendants du langage cible et de la qualité du code modèle fourni par le professeur.
Réserve sur la fiabilité du papier
Ce papier n'est pas à citer pour une méthode précise, seulement comme index vers des références plus profondes.Ce papier fonctionne donc comme un agrégateur de pistes.
},
 file = {Full Text PDF:files/106/Reddy et al. - 2025 - Graph-Based Semantic Similarity for Programming Exercise Assessment A Survey.pdf:application/pdf},
}

@article{milovancevic_automated_nodate,
 title = {Automated Induction for Proving Program Equivalence},
 abstract = {Formal verification has made great advances in recent decades, resulting in tools that can verify strong correctness properties of important pieces of software infrastructure. In this thesis, we study a particular instance of formal verification: equivalence checking, and its applications in program verification. We propose a fully automated approach to equivalence checking that takes as input candidate programs and reference programs and uses functional induction to automatically prove or disprove the correctness of each candidate program. We next extend our approach to support equivalence checking of underspecified programs, and propose a new application of equivalence checking for measure transfer in termination proving. We implement our approach on top of the Stainless verifier to support equivalence checking of Scala programs. To evaluate our approach, we assemble data sets comprising a total of around 5000 Scala programs, drawn from equivalence checking benchmarks and programming assignments. Our evaluation and a case study show that our system outperforms state-of-the-art tools and is applicable to automated grading in undergraduate programming courses.},
 author = {Milovancevic, Dragana},
 langid = {english},
 annotation = {Note de lecture

Cette thèse propose de corriger les devoirs de programmation en remplaçant les tests aveugles par des preuves mathématiques. Le système certifie si la logique de l'étudiant est identique à celle du prof, fabrique des contre-exemples sur mesure en cas d'erreur, et regroupe automatiquement la classe par "façons de penser".

1. {LE} {PROBLÈME} {DES} {CORRECTEURS} {CLASSIQUES}
Les correcteurs actuels utilisent des tests (ex: si l'entrée est 2, le résultat est-il 4 ?).


Faille : Un étudiant peut coder une solution fausse qui passe les petits tests par hasard, mais plante sur de grands nombres.


Boîte noire : Les tests vérifient le résultat final mais ignorent la logique de l'étudiant (a-t-il utilisé l'algorithme demandé ? est-ce optimisé ?).


2. {LA} {SOLUTION} : {TRADUIRE} {LE} {CODE} {EN} {MATHÉMATIQUES}
Au lieu de tester le code, le système (via l'outil Stainless) le traduit en une équation mathématique géante pour prouver formellement qu'il est identique au code du professeur.

La traduction se fait en 4 étapes :



Nettoyage : Les boucles impératives (while,for) sont secrètement transformées en fonctions récursives.


Logique Booléenne : Les "Arbres de décision" du code (les embranchements if/else) deviennent une équation logique avec des {ET} et des {OU}.


L'Induction Fonctionnelle (Le sortilège de la récurrence) : Une boucle est infinie, ce qui ferait exploser l'équation. Le système utilise la preuve par récurrence : il admet mathématiquement que la suite de la boucle est juste, et prouve uniquement que l'action immédiate de l'étudiant est égale à celle du prof. L'équation devient courte et finie.


Le Détective (Solveur {SMT} Z3) : L'équation est envoyée au super-calculateur Z3.



3. {LA} {MÉCANIQUE} {DES} {CONTRE}-{EXEMPLES} {SUR} {MESURE}
Le solveur Z3 ne teste pas des chiffres au hasard. Il procède par preuve par l'absurde :


Il pose l'équation : "Existe-t-il dans l'univers une valeur de X où Étudiant(X) different du Prof(X) ?"


Si le solveur trouve une contradiction logique dans les arbres de décision, il recrache les valeurs exactes de la faille (un "Modèle").


Stainless retraduit ces mathématiques en code et affiche à l'étudiant un contre-exemple inventé sur mesure (ex: "Ton code plante exactement avec la liste [1,2] et n=0 .


4. {LE} {MUR} {DU} {TEMPS} {ET} L'{USINE} {DE} {TRI} ({CLUSTERING})
Comparer des arbres logiques est lourd. Si un étudiant a inversé ses conditions et sa boucle par rapport au prof, la complexité mathématique explose. Le solveur a une limite stricte : 1 seconde par copie (Timeout). Pour trier tout le monde sans saturer, le système utilise un entonnoir en 4 étapes :


Le Vigile (Filtre de forme) : Rejet direct des codes qui n'ont pas la bonne signature (ex: renvoie du texte au lieu de nombres).


Le Champ de mines (Tests rapides) : Le système garde en mémoire les failles (contre-exemples) trouvées chez les étudiants précédents et teste les nouvelles copies dessus. Si ça explose, c'est faux direct. Zéro calcul mathématique gaspillé.


L'Effet Domino (La Transitivité) : C'est la clé du système. Si comparer l'étudiant B au Prof prend plus d'1 seconde (Timeout), la machine compare B à l'étudiant A (qui a déjà été validé). S'ils ont la même logique, l'équation est simple et prend 0,1 sec. Puisque B = A, et que A = Prof, la machine déduit que B = Prof !


Le Repêchage : À la fin, la machine reprend les "Inconnus" et les compare aux nouveaux modèles validés pour les repêcher.


5. {LES} {OUTILS} {POUR} {GÉRER} {LA} {VRAIE} {VIE} {DU} {CODE}


Le Puzzle (Function Call Matching) : Le système fouille la copie pour repérer les sous-fonctions créées par l'étudiant et les relier à celles du professeur.


Tolérer les réponses multiples (Sous-spécification) : Pour les exercices ayant plusieurs réponses valides (ex: trouver un nombre pair), l'enseignant ajoute un filtre (Normalisation) qui dit à la machine de valider toute variante mathématique respectant la règle.


L'anti-plantage (Measure Transfer) : L'induction mathématique est fausse si le code tourne en boucle infinie. Le système "emprunte" la garantie d'arrêt (preuve de terminaison) du prof et l'applique à la copie pour certifier qu'elle finira par s'arrêter.


{LE} {RÉSULTAT} {FINAL} {POUR} {LE} {PROFESSEUR}
Le système ne crache pas juste des notes, mais une cartographie des cerveaux de la classe :


Les Familles (Clusters) : Les étudiants sont regroupés par stratégie (ex: "Le groupe qui utilise la soustraction" vs "Le groupe qui utilise le modulo").


Les Solitaires (Singletons) : Les étudiants isolés dans le panier "Inconnu". Leurs codes (bons ou mauvais) sont tellement uniques que la machine n'a pas pu les classer. L'enseignant sait qu'il doit concentrer son temps sur eux.



},
 annotation = {Téléchargé le 31/07/2026 quand on cherchait des articles citant : “Software verification and graph similarity for automated evaluation of students' assignments”
C’est une thèse, peut être pas intéressantes mais pour le savoir il faut la lire
},
 file = {PDF:files/115/Milovancevic - Automated Induction for Proving Program Equivalence.pdf:application/pdf},
}

@incollection{vafeiadis_formal_2025,
 location = {Cham},
 title = {Formal Autograding in a Classroom},
 volume = {15695},
 isbn = {978-3-031-91120-0},
 url = {https://link.springer.com/10.1007/978-3-031-91121-7_7},
 doi = {10.1007/978-3-031-91121-7_7},
 abstract = {We report our experience in enhancing automated grading in an undergraduate programming course using formal verification. In our experiment, we deploy a program verifier to check the equivalence between student submissions and our reference solutions, alongside the existing testing-based grading infrastructure. We were able to use program equivalence to differentiate student submissions according to their high-level program structure, in particular their recursion pattern, even when their input-output behaviour is identical. Consequently, we achieve (1) higher confidence in correctness of idiomatic solutions but also (2) more thorough assessment of solution landscape that reveals solutions beyond those envisioned by instructors.},
 pages = {154--174},
 booktitle = {Programming Languages and Systems},
 publisher = {Springer Nature Switzerland},
 author = {Milovančević, Dragana and Bucev, Mario and Wojnarowski, Marcin and Chassot, Samuel and Kunčak, Viktor},
 editor = {Vafeiadis, Viktor},
 urldate = {2026-07-31},
 date = {2025},
 langid = {english},
 note = {Series Title: Lecture Notes in Computer Science},
 annotation = {Note de lecture

Le but de l'expérience
Les professeurs de l'{EPFL} en avaient assez des correcteurs automatiques basés uniquement sur des tests (qui laissent passer des bugs et ne disent rien sur la logique de l'étudiant). Ils ont donc branché Stainless (le vérificateur formel) directement sur la plateforme de rendu de devoirs des étudiants (Moodle) pour un cours de programmation en Scala.
Le but : voir si la machine peut corriger les étudiants en temps réel, prouver leur code mathématiquement, et regrouper les étudiants par "façons de penser" (le fameux Clustering).
2. Le Crash-Test : La première expérience (Automne 2023)
Ils ont testé le système sur 4 exercices avec environ 200 étudiants volontaires (soit plus de 700 rendus). Le Résultat a été mitigé :


Le positif : La machine a trouvé plein de bugs de sécurité (divisions par zéro, etc.) que les tests classiques n'avaient pas vus. Elle a aussi réussi à isoler les étudiants ayant eu des approches bizarres ou uniques (les clusters Singletons).


Le problème (L'avalanche de Timeouts) : Sur les codes sans erreur de syntaxe, 42 \% ont fait un "Timeout" (la machine a dépassé la limite d'1 seconde et a abandonné), contre seulement 13 \% prouvés corrects.


Pourquoi un tel échec sur les Timeouts ? Parce que les professeurs n'avaient donné qu'{UNE} {SEULE} solution de référence par exercice. Si un étudiant faisait un code avec des additions et que le prof avait utilisé des modulos (\%), la "distance logique" était trop grande pour la machine, l'équation explosait, et le solveur Z3 coupait au bout d'1 seconde.
3. La Correction : La deuxième expérience (Automne 2024)
L'année suivante, ils ont déployé le système sur 11 exercices avec de gros ajustements.
Les 3 changements majeurs :


Plusieurs profs, plusieurs modèles : Ils ont fourni plusieurs solutions de référence (une avec boucle, une récursive, une optimisée, etc.).


Le découpage en sous-tâches : Au lieu de demander un code géant, ils ont découpé les exercices en petites fonctions (ex: faire la fonction addition d'abord, puis faire multiplication ensuite).


Un petit cours de maths : Ils ont brièvement expliqué aux étudiants comment fonctionnait l'outil Stainless. Étonnamment, certains étudiants se sont mis à écrire d'eux-mêmes des formules mathématiques de vérification dans leur code pour s'aider !


Le Résultat (Une réussite totale) : Le taux de réussite a explosé. Les codes prouvés mathématiquement corrects sont passés de 13 \% à plus de 50 \%, et les Timeouts ont chuté à seulement 20 \%. Le système a été capable de corriger 5 exercices de bout en bout de façon 100 \% automatisée.
4. Les 3 Nouvelles Inventions Techniques (Section 6)
C'est la partie technique la plus importante du papier. En voyant comment les vrais étudiants codaient, les chercheurs ont dû améliorer leur outil Stainless. Ils ont ajouté 3 nouvelles fonctionnalités :
A. Le système de "Cache" pour les sous-tâches (L'innovation majeure)
Imaginons un exercice où l'étudiant doit coder Addition  puis utiliser cette addition pour coder Multiplication. Avant, quand la machine comparait la Multiplication  de l'étudiant avec celle du prof, elle devait re-prouver l'addition à l'intérieur. C'était lourd et ça faisait des Timeouts. La solution : Ils ont créé une mémoire Cache. Si la machine a déjà classé les étudiants dans des "familles d'Addition" (Clusters), elle garde le résultat en mémoire. Quand elle corrige la Multiplication, elle passe l'étape de l'addition car c'est "déjà prouvé". Conséquence : Ça a sauvé le système ! Ça évite que l'ordinateur ne refasse les mêmes calculs et ça permet de regrouper beaucoup plus d'étudiants dans les mêmes familles (regroupement hiérarchique).
B. La Récursion Mutuelle
Parfois, une fonction A appelle une fonction B, qui rappelle la fonction A (comme un match de ping-pong). Au début de l'expérience, le système ne savait pas lire ça. Ils ont modifié l'algorithme d'appariement (Function Call Matching) pour que la machine puisse comprendre ces "boucles en duo".
C. Le "Measure Transfer" (Le transfert de preuve d'arrêt)
Ils se sont rendu compte que même si les étudiants codaient très différemment, la "raison" pour laquelle leur code finissait par s'arrêter (et ne pas tourner à l'infini) était toujours la même. Ils ont donc appris à la machine à "copier-coller" la preuve d'arrêt du professeur sur la copie de l'étudiant pour gagner énormément de temps de calcul.
},
 annotation = {Téléchargé le 31/07/2026 lié à la thèse de Dragana
},
 file = {PDF:files/118/Milovančević et al. - 2025 - Formal Autograding in a Classroom.pdf:application/pdf},
}

@article{paiva_automated_2022,
 title = {Automated Assessment in Computer Science Education: A State-of-the-Art Review},
 volume = {22},
 issn = {1946-6226, 1946-6226},
 url = {https://dl.acm.org/doi/10.1145/3513140},
 doi = {10.1145/3513140},
 shorttitle = {Automated Assessment in Computer Science Education},
 abstract = {Practical programming competencies are critical to the success in computer science ({CS}) education and go-to-market of fresh graduates. Acquiring the required level of skills is a long journey of discovery, trial and error, and optimization seeking through a broad range of programming activities that learners must perform themselves. It is not reasonable to consider that teachers could evaluate all attempts that the average learner should develop multiplied by the number of students enrolled in a course, much less in a timely, deep, and fair fashion. Unsurprisingly, exploring the formal structure of programs to automate the assessment of certain features has long been a hot topic among {CS} education practitioners. Assessing a program is considerably more complex than asserting its functional correctness, as the proliferation of tools and techniques in the literature over the past decades indicates. Program efficiency, behavior, and readability, among many other features, assessed either statically or dynamically, are now also relevant for automatic evaluation. The outcome of an evaluation evolved from the primordial Boolean values to information about errors and tips on how to advance, possibly taking into account similar solutions. This work surveys the state of the art in the automated assessment of {CS} assignments, focusing on the supported types of exercises, security measures adopted, testing techniques used, type of feedback produced, and the information they offer the teacher to understand and optimize learning. A new era of automated assessment, capitalizing on static analysis techniques and containerization, has been identified. Furthermore, this review presents several other findings from the conducted review, discusses the current challenges of the field, and proposes some future research directions.},
 pages = {1--40},
 number = {3},
 journaltitle = {{ACM} Transactions on Computing Education},
 shortjournal = {{ACM} Trans. Comput. Educ.},
 author = {Paiva, José Carlos and Leal, José Paulo and Figueira, Álvaro},
 urldate = {2026-07-31},
 date = {2022-09-30},
 langid = {english},
 annotation = {Note de lecture

Objectif de la revue
Dresser une vue panoramique et un état de l'art complet de la recherche sur l'évaluation automatique dans l'enseignement de l'informatique pour la période 2010–2021 (basé sur une analyse rigoureuse de 899 publications et de 30 outils majeurs).

5 Axes principaux étudiés (Questions de recherche)

{RQ}1 : Que peut-on évaluer automatiquement en dehors des exercices de code classiques ?


En clair : Habituellement, un correcteur automatique vérifie de petits programmes écrits en ligne de commande. Mais qu'en est-il du reste du programme d'informatique ?


Ce que le papier montre : Les chercheurs ont réussi à automatiser la correction de sujets beaucoup plus variés et complexes :


La programmation visuelle : Corriger des projets faits par des débutants sur Scratch ou Snap!.


Les interfaces graphiques et le Web : Vérifier si un site web ou une application Android fonctionne bien visuellement et répond correctement aux clics.


Les bases de données : Tester si des requêtes {SQL} extraient les bonnes données sans failles de sécurité.


La modélisation : Vérifier si un schéma de base de données ({ER}) ou un diagramme de classe ({UML}) fait par un étudiant est correct en le comparant au schéma du prof.


Les compétences en test : Évaluer si l'étudiant a lui-même écrit de bons tests pour vérifier son propre code.




{RQ}2 : Quelles techniques sont utilisées pour analyser et noter le code ?


En clair : Comment la machine s'y prend-elle concrètement pour décider si un code est bon, moyen ou mauvais ?


Ce que le papier montre : Il y a deux grandes manières de faire :


L'analyse dynamique (On exécute le code) : On donne des entrées au programme et on regarde ce qu'il affiche. Aujourd'hui, on utilise de plus en plus des outils industriels (comme les tests unitaires {JUnit}) pour tester le code sous toutes ses coutures.


L'analyse statique (On lit la structure du code sans l'exécuter) : C'est la grande tendance. On transforme le code en arbre de structure ({AST}) ou en graphe. Cela permet de :


Mieux comprendre la logique de l'étudiant même si le code ne compile pas.


Détecter les mauvaises pratiques (variables inutilisées, code trop complexe) avec des outils comme Checkstyle ou {SonarQube}.


Détecter le plagiat en comparant la structure interne de deux devoirs.






{RQ}3 : Comment exécuter le code des étudiants en toute sécurité ?


En clair : Si un étudiant envoie un programme malveillant (qui essaie de pirater le serveur) ou une boucle infinie (qui fait planter l'ordinateur), comment protéger le système ?


Ce que le papier montre : L'article identifie l'arrivée de "l'Ère de la Conteneurisation" :


Avant, on utilisait des comptes utilisateurs bridés ou de lourdes Machines Virtuelles ({VM}) qui prenaient beaucoup de temps à démarrer.


Aujourd'hui, la majorité des outils récents utilisent Docker (des conteneurs). C'est une boîte isolée et très légère : le code s'exécute à l'intérieur sans aucun accès au reste du serveur, puis la boîte est détruite. C'est rapide, propre et sécurisé.




{RQ}4 : Comment générer des retours (feedback) utiles pour l'étudiant ?


En clair : Dire à un étudiant "Ton code est faux" ne l'aide pas à apprendre. Comment la machine peut-elle lui expliquer comment corriger son erreur ?


Ce que le papier montre : On passe d'un simple message d'erreur à des conseils personnalisés (Knowledge about How to proceed) :


Correction automatique ({APR} - Automated Program Repair) : La machine analyse le code de l'étudiant, repère le bug et calcule la modification minimale à faire.


Génération d'indices (Hints) : Au lieu de donner la réponse, l'outil Compare le code de l'étudiant avec ceux d'autres étudiants ayant réussi, pour lui donner un indice sur la prochaine étape logique.




{RQ}5 : Comment analyser le comportement et l'apprentissage des étudiants ?


En clair : Quelles informations les enseignants peuvent-ils récupérer pour comprendre où la classe rencontre des difficultés ?


Ce que le papier montre : C'est le domaine du Learning Analytics (l'analyse des données d'apprentissage) :


Ce qu'on collecte : Certains outils enregistrent l'historique complet du code (via Git) ou même chaque frappe sur le clavier (keystrokes).


Ce qu'on en fait : Les profs disposent de tableaux de bord montrant la progression, le temps passé sur un exercice, ou les erreurs de syntaxe les plus fréquentes.


Standardisation : Création du format {ProgSnap}2, un standard international pour sauvegarder ces données de code afin que les chercheurs du monde entier puissent les partager et les analyser facilement.





Résultats clés \& Constats


Évolution de la notion de "Code Correct" : La justesse d'un programme ne se limite plus à la validation de jeux de tests (blackbox). La stratégie adoptée, la qualité du code et la complexité algorithmique font désormais partie intégrante de la note.


Transition technologique : Déplacement significatif vers les approches par analyse statique ({AST}, {CFG}) et vers la conteneurisation (Docker) pour l'exécution sécurisée.


Open-Source : Plus de 50 \% des outils analysés sont désormais open-source (Submitty, Edgar, {CodeOcean}, {VPL}), ce qui favorise la reproductibilité des travaux de recherche.


Limites et Besoins futurs


Manque d'études empiriques à grande échelle : La majorité des nouveaux outils/méthodes ne sont validés que sur de petits groupes d'étudiants homogènes ou via des prototypes fermés.


Feedback encore insuffisant : Bien que l'{APR} et l'analyse statique progressent, le feedback automatique reste souvent centré sur la correction du bug plutôt que sur la compréhension de l'erreur conceptuelle par l'étudiant.


Besoin de prioriser la sémantique sur la syntaxe : Renforcer les modèles capables de comprendre l'intention de l'étudiant à partir des représentations graphiques ou de l'{AST} du code.


},
 annotation = {Téléchargé le 31/07/2026 dans le cadre des articles qui citent : Software verification and graph similarity for automated evaluation of students' assignments

},
 file = {PDF:files/122/Paiva et al. - 2022 - Automated Assessment in Computer Science Education A State-of-the-Art Review.pdf:application/pdf},
}

@article{paiva_comparing_2024,
 title = {Comparing semantic graph representations of source code: The case of automatic feedback on programming assignments},
 volume = {21},
 rights = {http://creativecommons.org/licenses/by-nc-nd/4.0/},
 issn = {1820-0214, 2406-1018},
 url = {https://doiserbia.nb.rs/Article.aspx?ID=1820-02142400004P},
 doi = {10.2298/CSIS230615004P},
 shorttitle = {Comparing semantic graph representations of source code},
 abstract = {Static source code analysis techniques are gaining relevance in automated assessment of programming assignments as they can provide less rigorous evaluation and more comprehensive and formative feedback. These techniques focus on source code aspects rather than requiring effective code execution. To this end, syntactic and semantic information encoded in textual data is typically represented internally as graphs, after parsing and other preprocessing stages. Static automated assessment techniques, therefore, draw inferences from intermediate representations to determine the correctness of a solution and derive feedback. Consequently, achieving the most effective semantic graph representation of source code for the specific task is critical, impacting both techniques’ accuracy, outcome, and execution time. This paper aims to provide a thorough comparison of the most widespread semantic graph representations for the automated assessment of programming assignments, including usage examples, facets, and costs for each of these representations. A benchmark has been conducted to assess their cost using the Abstract Syntax Tree ({AST}) as a baseline. The results demonstrate that the Code Property Graph ({CPG}) is the most feature-rich representation, but also the largest and most space-consuming (about 33\% more than {AST}).},
 pages = {117--142},
 number = {1},
 journaltitle = {Computer Science and Information Systems},
 shortjournal = {{ComSIS}},
 author = {Paiva, José and Leal, José and Figueira, Álvaro},
 urldate = {2026-07-31},
 date = {2024},
 langid = {english},
 annotation = {Note de lecture

1. Le Problème : Comment aider un étudiant sans exécuter son code ?
Pour corriger un devoir d'informatique de façon intelligente, un système automatique ne doit pas se contenter de dire "C'est faux". Il doit dire "Voici pourquoi c'est faux". Pour faire cela sans même lancer le programme, l'ordinateur transforme le texte du code en une "carte mentale" appelée Graphe. Ce papier cherche à déterminer quelle est la meilleure "carte" (la plus détaillée, mais pas trop lourde à stocker) pour générer ces conseils automatiques (feedbacks).
2. Le "Dico" des Graphes
Un Graphe est un réseau de points (les nœuds) reliés par des flèches (les arêtes). L'article compare plusieurs façons de dessiner cette carte :


L'{AST} (L'Arbre Grammatical) : C'est la traduction mot à mot du code. C'est très détaillé syntaxiquement, mais ça ne montre pas la logique globale.


Le {CFG} (L'Organigramme ou Flux de Contrôle) : Il montre les "chemins" possibles du code. C'est une carte routière qui dit : "Si X est vrai, on va par là, sinon on va par là".


Le {DFG} (Le Flux de Données) : Il suit la vie des variables. Il relie le moment où une donnée est créée au moment où elle est utilisée ou modifiée.


Le {PDG} (Le Graphe de Dépendances) : Il ignore l'ordre d'écriture des lignes et se concentre sur les liens de cause à effet. (Exemple : La ligne 10 n'existe que parce que le "Si" de la ligne 2 est vrai).


Le {CPG} (Le Méga-Graphe) : C'est le graphe ultime. Il fusionne l'{AST}, le {CFG} et le {PDG} en un seul schéma. Il contient tout : la syntaxe, les chemins et les dépendances.


3. La "Similarité" : Comment l'article définit-il deux codes "similaires" ?
C'est un point central du papier (Section 4.2). Pour l'ordinateur, la similarité n'est pas textuelle. Deux étudiants peuvent utiliser des noms de variables totalement différents ou ajouter des espaces, l'ordinateur s'en moque. L'article caractérise la similarité de façon comportementale et stratégique (sémantique) :


La stratégie algorithmique : Deux programmes sont considérés similaires s'ils résolvent le problème de la même manière (par exemple : tous les deux utilisent une boucle "Tant que" au lieu de se rappeler eux-mêmes via une "Récursion").


Comment la mesurer ? Le papier explique que les graphes de flux (comme le {CFG}) ou de dépendances (comme le {SDG}) sont les meilleurs outils pour mesurer cette similarité. Superposer deux {CFG} permet de voir si "l'itinéraire" mental des deux étudiants est le même, même si le code écrit est différent. C'est aussi la méthode reine pour détecter le plagiat (triche) déguisé.


4. Les Résultats de l'Expérience (Le Match des Graphes)
Les chercheurs ont testé la création de ces graphes sur de vrais devoirs d'étudiants (en C, Python et Java) pour comparer leur "poids" et leur utilité :


Le Graphe le plus lourd (Le {CPG}) : C'est le gagnant absolu en termes d'informations. Cependant, parce qu'il contient tout, il prend environ 33 \% à 50 \% d'espace de stockage en plus que les autres et est plus lent à fabriquer.


Les Graphes ciblés ({PDG} / {CFG}) : Ils sont plus légers et excellents pour des missions précises. Par exemple, le {PDG} suffit largement pour détecter si un étudiant a écrit du "code mort" (du code qui ne servira jamais).


L'impact du langage : Un code écrit en Java générera un graphe beaucoup plus lourd et complexe qu'un code écrit en Python, car le Java demande d'écrire beaucoup plus de mots pour faire la même chose.


5. La Conclusion : La Méthode Idéale pour le Feedback
Pour donner un bon conseil à l'étudiant sans faire exploser les serveurs informatiques, les auteurs recommandent une approche en deux temps :


Le Tri Rapide (avec le {CFG}) : Quand l'étudiant soumet un code faux, la machine extrait son {CFG} (léger) pour fouiller dans les archives. Elle cherche une bonne solution passée qui a exactement la même similarité stratégique (la même structure globale de résolution).


Le Diagnostic Précis (avec le {CPG}) : Une fois le bon "modèle" trouvé, la machine génère le {CPG} (lourd mais ultra-détaillé) de l'étudiant et du modèle. En superposant ces deux méga-graphes, la machine trouve la différence mécanique exacte (ex: une variable est mal branchée). Un dictionnaire de règles traduit ensuite cette différence visuelle en une phrase de conseil humain : "Attention, tu as initialisé ta variable au mauvais endroit.


},
 annotation = {Téléchargé le 31/07/2026 dans le cadre des articles qui citent : Software verification and graph similarity for automated evaluation of students' assignments

},
 file = {PDF:files/124/Paiva et al. - 2024 - Comparing semantic graph representations of source code The case of automatic feedback on programmi.pdf:application/pdf},
}

@inproceedings{inturi_programming_2023,
 title = {Programming Assignment Grading Through Control Statement and Program Features},
 url = {https://ieeexplore.ieee.org/abstract/document/10331134},
 doi = {10.1109/ICETCI58599.2023.10331134},
 abstract = {Recently, automatic programming assessment has grown in importance as a technique for supporting lecturers and instructors of programming courses in automatically marking and grading students programming exercises and giving helpful feedback on the students programming answers. In this paper, we propose a method for evaluating C programs. Static and dynamic analysis methods are two distinct strategies that are distinguished in this context. In contrast to dynamic analysis, which must assess an executable program, static analysis can analyse a program even if it is not totally executed. The proposed approach is based on the static analysis of programs. This paper introduces two metrics to grade student programs by using (i) Control Statement Features (ii) Program Features like different types of statements, operators and operands.It consists of comparing the student program with the program offered by the evaluator through feature metrics.Dealing with the number of solutions that are available for the same programming problem presents a significant difficulty in this situation. To address this flaw, we suggest a novel similarity metric that contrasts two programs based on how they execute semantically.In the area of automated program evaluation, the experiments findings point to a promising realisation. They further prove that the proposed method guarantees a close approximation to the human program evaluation.},
