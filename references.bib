 author = {Wehmeier, Leon and Eilermann, Sebastian and Niggemann, Oliver and Deuter, Andreas},
 urldate = {2026-07-31},
 date = {2023-10},
 note = {{ISSN}: 2377-634X},
 keywords = {Semantics, automated feedback, Codes, Education, Electronic learning, programming task assessment, semantic code assessment, Soft sensors, software engineering, Syntactics, Task analysis},
 annotation = {Téléchargé le 31/07/2026 dans le cadre des articles qui citent : Software verification and graph similarity for automated evaluation of students' assignments
},
