@book{paukovics_actes_2026,
 location = {Grenoble, France},
 title = {Actes des onzièmes rencontres jeunes chercheuses et chercheurs en {EIAH}},
 url = {https://hal.science/hal-05647734},
 abstract = {Les onzièmes Rencontres Jeunes Chercheuses et Chercheurs en {EIAH} ({RJC} {EIAH} 2026, https://rjc-eiah2026.sciencesconf.org) se sont tenues à l’Université de Grenoble du 9 au 12 juin 2026. Ces rencontres offrent une occasion particulièrement importante pour les jeunes chercheur·e·s de la communauté {EIAH} (Environnements Informatiques pour l’Apprentissage Humain) de pouvoir se rencontrer et échanger autour de leurs travaux avec des pairs et des chercheur·e·s séniors. Ces rencontres francophones, organisées tous les deux ans sous l’égide de l’{ATIEF} (Association des Technologies de l'Information pour l'Éducation et la Formation) visent le développement de la communauté {EIAH} par la formation des jeunes chercheur.e.s issus des différentes disciplines inhérentes au domaine des {EIAH} et la diffusion de leurs travaux.},
 publisher = {Université Grenoble Alpes and {ATIEF}},
 author = {Paukovics, Elsa and Lallé, Sébastien},
 urldate = {2026-06-15},
 date = {2026-06},
 note = {Publication Title: Onzièmes rencontres jeunes chercheuses et chercheurs en {EIAH} ({RJC} {EIAH} 2026)},
 keywords = {-, d'Apprentissage, {EIAH}, Environnement, Humain, Informatique},
 annotation = {En recherchant Embedding dans le document il ressort que la méthodologie utilisé pour la partie qui nous intéresse(embedding ) se fait avec un model bi-encodeur.
Un modèle bi-encodeur est une architecture d'intelligence artificielle utilisée dans le traitement du langage naturel  pour comparer deux textes et mesurer leur ressemblance (similarité sémantique).
Plus concrètement : étant donné deux texte A et B on a le schéma qui suit
Texte A passe dans l'encodeur A → Il est transformé en un vecteur (une suite de nombres) appelé Embedding A.
Texte B passe dans l'encodeur B → Il est transformé en un Embedding B.
Calcul de similarité : Une fois que l'on a ces deux vecteurs, on utilise généralement la similarité cosinus, pour obtenir un score entre -1 et 1 (ou 0 et 1). Plus le score est proche de 1, plus les textes ont le même sens.(c'est une question de proximité entre les vecteurs plus  deux vecteurs sont proches dans l'espaces plus leur cosinus se rapproches de 1 et si c'est 1 les deux vecteurs sont confondu donc la phrase qu'il represent est casi la meme)
Pour revenir sur le papier sentence-camembert-large est le model qui montre le plus avantage  lié aux tâches de similarité sémantique et utilisé par l’intermédiaire du  framework Sentence-Transformers avec un entraînement reposant sur  {MNRL}(Multiple Negatives Ranking Loss)
Comment fonctionne la {MNRL} ?
Le modèle reçoit des paires de textes positives (Ai​,Bi​) qui sont sémantiquement liées (par exemple, une compétence et son activité correspondante).
Pour une paire donnée, toutes les autres paires présentes dans le même lot d'entraînement (batch) servent de fausses correspondances (exemples négatifs).
La {MNRL} force le modèle à maximiser la similarité entre la vraie paire (Ai​,Bi​) tout en minimisant la similarité avec toutes les autres propositions du lot.
Remarque : Ce qui ne pourrait pas être utiliser dans notre cas,car on a  pas de paires d'exercices similaires pré-définies.Une alternative sera proposé plus bas tout en gardant certain point.
Pour complété le modèl dynamique  cité plus haut un model staique ({TF}-{IDF}) à été ajouté pour avoir la fois les correspondances lexicales({TF}-{IDF}) et la similarité sémantique(sentence-camembert-large fine-tuné).
 {TF}-{IDF} permet de repérer les mots-clés uniques qui définissent le sujet d'un texte, en ignorant les mots banals.
Ainsi un score est calculé avec ces deux models et associées proportionnellement tels que score finale soit :
scorehybrid(qi, dj ) = α · scorelex(qi, dj ) + (1 − α) · scoref t(qi, dj ), avec le parametre α qui varie entre 0 et 1.
les valeurs concluante de α ont été entre 0.8 et 0.9 donc ça constitue un bon début pour nos prochains test
Ce qui est intéressant ici c'est que on peut prendre cette approche dans notre cas malgré le forma de nos donné.
Juste en substituant qi et dj par les deux énoncé que l'on cherche a trouvé le degré de similarité.
Ca deviendra donc :
Score\_hybrid​(A,B)=α⋅Score\_TF-{IDFˊ}​(A,B)+(1−α)⋅Similariteˊcosinus\_BERT(A,B) avec α entre 0.8 et 0.9
En outre ce score sera renforcé par le score du code qui lui passera par le {GNN}








},
 file = {HAL PDF Full Text:files/19/Paukovics et Lallé - 2026 - Actes des onzièmes rencontres jeunes chercheuses et chercheurs en EIAH.pdf:application/pdf},
}

