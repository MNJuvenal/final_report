@article{siddiqui_c_nodate,
 title = {C Language Embeddings for Code Classiﬁcation: A Comparative Study},
 abstract = {The ever-increasing demand for automated code assessment has prompted us to evaluate existing resources. Current methods include running the code through a set of test cases, grading on ﬁxed criteria for generalized semantic structures, or calculating document similarities. Because these systems do not respond to the semantic understanding of the code, they fail to tolerate partially correct solutions. This research proposes using code2vec as a base, where meaningful code-vector encodings are derived from the abstract syntax tree and trained on various approaches for evaluating student-written codes that replicate human checking. The efﬁcacy of this approach on Clanguage codes is shown by predicting marks(grades) against the vector formed from the code ﬁle. It was important to train on a data set containing diverse solution ﬁles, ranging from incorrect, partially correct or correct, hence we crowdsourced the data from students currently enrolled in a {BSc}(Computer Science) program. The paper discusses the performance of this approach on multiple Neural Network models, trained on the same data set.},
 author = {Siddiqui, Unais and Iqbal, Alishbah and Mirza, Fakhiha and Shamsi, Dr Jawwad},
 langid = {english},
 annotation = {Note de lecture

Objectif de la recherche
Proposer et évaluer une méthode d'évaluation automatique du code source en C basée sur l'adaptation de code2vec. L'objectif est de dépasser les approches traditionnelles (jeux de tests stricts ou comparaison syntaxique directe) pour tolérer les solutions partiellement correctes en capturant la structure sémantique du code.
Méthodologie


Prétraitement (Embeddings C) :


Génération des Arbres de Syntaxe Abstraite ({AST}) via le compilateur Clang.


Extraction de triplets de contexte sous la forme :

[Noeud\_Début] \{Chemin {AST}\} \{Noeud\_Fin\}



Concaténation des embeddings de ces 3 éléments pour former un sac de chemins (bag of paths).




Un chemin part d'une feuille de l'{AST} vers une autre, reliant ainsi chaque paire de feuilles.



Modèles comparés :


Path-Attention (code2vec) : Applique un mécanisme d'attention sur les chemins {AST} pour générer un vecteur de code unique.


{LSTM} : Traite les contextes sous forme de séquence temporelle.


{BERT} : Utilise des encodages positionnels pour structurer la représentation globale.




Jeu de données :


Projets d'étudiants ({FAST}-{NUCES}), données crowdsourcées et exercices complets/intermédiaires scraped depuis {HackerRank}.




Résultats principaux


Validation des vecteurs C : La similarité cosinus entre les embeddings C générés et les embeddings Java de code2vec montre une cohérence de distance spatiale (écart constant de {\textasciitilde}10\%).


Performance : Le modèle Path-Attention surpasse nettement {LSTM} et {BERT} (F1-score et Précision de 51\%).


Constat clé : Le code source ne se prête pas bien au traitement séquentiel ({LSTM}) ou positionnel strict ({BERT}). La structure d'attention par chemins {AST} reflète mieux la logique modulaire des programmes.


Limites identifiées


Entraînement par question (1-to-1) : Un modèle doit être entraîné spécifiquement pour chaque sujet/problème.


Déséquilibre des classes : Données concentrées sur le 0\% (échec) et le 100\% (succès), avec peu de codes partiellement corrects.


Problème de classification vs Régression : La classification discrète peine à gérer les cas limites entre les bornes de notes.


Perspectives de recherche


Évoluer vers un modèle de régression pour obtenir des notes continues.


Combiner le traitement du langage naturel (énoncé de la question) et la représentation du code pour créer un modèle agnostique à la question.


Exploiter les poids d'attention des chemins pour fournir des retours explicatifs aux étudiants.


},
 annotation = {Téléchargé le 31/07/2026 dans le cadre des articles qui citent : Software verification and graph similarity for automated evaluation of students' assignments
Plus {AST}
},
 file = {PDF:files/143/Siddiqui et al. - C Language Embeddings for Code Classiﬁcation A Comparative Study.pdf:application/pdf},
}

@article{prechelt_finding_nodate,
 title = {Finding Plagiarisms among a Set of Programs with {JPlag}},
 abstract = {{JPlag} is a web service that ﬁnds pairs of similar programs among a given set of programs. It has successfully been used in practice for detecting plagiarisms among student Java program submissions. Support for the languages C, C++ and Scheme is also available. We describe {JPlag}’s architecture and its comparsion algorithm, which is based on a known one called Greedy String Tiling. Then, the contribution of this paper is threefold: First, an evaluation of {JPlag}’s performance on several rather diﬀerent sets of Java programs shows that {JPlag} is very hard to deceive. More than 90 percent of the 77 plagiarisms within our various benchmark program sets are reliably detected and a majority of the others at least raise suspicion. The run time is just a few seconds for submissions of 100 programs of several hundred lines each. Second, a parameter study shows that the approach is fairly robust with respect to its conﬁguration parameters. Third, we study the kinds of attempts used for disguising plagiarisms, their frequency, and their success.},
 author = {Prechelt, Lutz and Malpohl, Guido and Philippsen, Michael},
 langid = {english},
 annotation = {Notes de lecture

Problématique \& Objectif : Détecter efficacement et automatiquement le plagiat de code source au sein de grands volumes de soumissions d'étudiants, en discriminant les coïncidences fortuites des véritables copies, malgré les tentatives de camouflage.

Solution \& Méthodologie (Le Comment) :
{JPlag} calcule la similarité entre deux programmes via un pipeline en deux étapes :


Tokenisation sémantique (Front-end) : Conversion du code source en une chaîne de jetons en éliminant les détails de surface (commentaires, formatage, noms de variables) et en injectant une sémantique structurelle forte pour éliminer les faux positifs dus au hasard.


Comparaison par paires (Greedy String Tiling - {GST}) : Comparaison des chaînes de jetons pour trouver les plus grands blocs communs non chevauchants (tiles), au-delà d'une longueur minimale \$M\$. Le score final de similarité correspond au pourcentage de jetons couverts, optimisé en pratique par un hachage de type Karp-Rabin pour garantir une exécution ultra-rapide.



Processus d'évaluation :
L'évaluation repose sur 4 jeux de programmes réels d'étudiants aux caractéristiques variées (Simple, Hard, Clean, Large), complétés par des ensembles artificiels de plagiats délibérés pour contrer l'outil (Hard.P, Large.P). La performance est mesurée via la Précision et le Rappel en testant différents paramètres (jeux de tokens, taille minimale de match \$M\$) et seuils de coupure.
Résultats \& Fiabilité :


Efficacité de détection : Performance parfaite sur les ensembles Simple, Clean et Large. Plus de 90 \% des vrais plagiaires détectés sur les jeux complexes, avec un seuil de coupure fixe optimal autour de 50 \%.


Résistance au camouflage : Les techniques basiques (changement de noms, commentaires, formatage) sont totalement inefficaces. Les attaques structurelles avancées échouent dans 90 \% des cas ou exigent un effort absurde qui dénature le code.


Robustesse : L'outil est très peu sensible aux variations de ses paramètres internes et surpasse ou égale les systèmes de référence (comme {MOSS}), notamment sur les petits programmes.


La limite de {JPlag} : Il aplatit le code en une simple chaîne de caractères (token string) ; en d'autres termes, il s'agit d'une simple comparaison de jetons textuels. Il ne voit pas les arbres (les hiérarchies d'instructions) et ne comprend pas le sens profond (la sémantique).


},
 annotation = {Téléchargé par Juvenal le 25/04/2026 pour comprendre comment {JPlag} calcul la similarité pour leur détecteur de plagiat (il présente l'ensemble de ses mécanismes en détail)

},
 file = {PDF:files/152/Prechelt et al. - Finding Plagiarisms among a Set of Programs with JPlag.pdf:application/pdf},
}

