@thesis{barollet_apprentissage_2023,
 title = {Apprentissage de la programmation par les problèmes : génération automatique d'exercices et recommandation},
 url = {https://theses.hal.science/tel-04586998},
 doi = {10.70675/033d9b14z4f20z4ba2za827zb4b96b8e0757},
 shorttitle = {Apprentissage de la programmation par les problèmes},
 abstract = {Teaching computer science is an important issue as more and more people need to use programming or computer science skills in their jobs.When programming, it is inevitable that some bugs occur.Debugging is a main task in programming and is seldom taught in computer science curricula.We usually learn debugging the hard way and become more efficient after gaining more experience.In this thesis, we will try to teach debugging and provide training exercises for novice programmers.There are already several Intelligent Tutoring Systems ({ITS}) on simpler topics like secondary school algebra.They host an exercise database and provide a recommendation on the next exercise to do.We will see that it might be too difficult to adapt these recommendation systems to a database of debugging exercises provided the complexity of the debugging activity.We will briefly study the automatic generation of debugging exercises.This will prove to have results far from the expectation and will require a change in the approach to teaching debugging.We present agdbentures, a debug practicing game that features increasing difficulty and carefully designed debugging exercises.Each exercise takes the form of a small mini-game that is impossible to win without fixing some bugs in the source code.Many efforts were made to increase the engagement of learners.The first experimental results of agdbentures with {CS}1 students are encouraging as they indeed enjoyed very much searching and fixing the bugs in agdbentures exercises.While developing agdbentures, we realized that the monitoring of an exterior program is a common task in many computer science teaching applications, for example, all visualization teaching tools.We developed easytracker, a framework to monitor program execution with a language-agnostic {API} for C (or any {GDB}-supported language) and Python.easytracker is used as a library to abstract many of agdbentures engineering regarding monitoring.We developed several other tools based on easytracker that we use in lectures to show program execution to demonstrate the benefits of easytracker when writing such a tool because all the effort can be put into visualization from a memory model.},
 institution = {Université Grenoble Alpes [2020-....]},
 type = {Theses},
 author = {Barollet, Théo},
 urldate = {2026-06-30},
 date = {2023-11},
 doi = {10.70675/033d9b14z4f20z4ba2za827zb4b96b8e0757},
 note = {Issue: 2023GRALM067},
 keywords = {Ai, Algorithmique, Algorithms, Enseignement, Ia, Teaching},
 annotation = {Note de Lecture
{ObjectifDévelopper} un système pour recommander et générer automatiquement des exercices de débogage en programmation (langage C) destinés à des étudiants novices, en s'appuyant sur les méthodes statistiques et de machine learning issues des systèmes de recommandation et du knowledge tracing.
Partie 1 — Recommandation d'{exercicesL}'auteur teste des méthodes historiques ({ELO} emprunté aux échecs, filtrage collaboratif, factorisation matricielle) sur des jeux de données éducatifs réels (Algebra I, {ASSISTments}, et un jeu de données collecté auprès du jeu Compute-{IT}). Constat central : contrairement aux données de recommandation classiques (films, achats), les données éducatives ne bénéficient presque pas d'une augmentation de la dimension du modèle — l'auteur l'attribue au fait que l'apprentissage évolue dans le temps, contrairement à un goût qui reste stable.
Partie 2 — Génération automatique d'exercices {buggésPlusieurs} approches sont testées (génération aléatoire contrainte par grammaire, {LSTM} entraîné sur du code réel, mutation de programmes, vérification d'équivalence par autoencodeur). Toutes produisent des résultats décevants : le code généré est illisible ou dépourvu de lien avec un objectif pédagogique précis.
Partie 3 — Changement de cap : conception {manuelleFace} à ces échecs, l'auteur abandonne l'approche statistique et développe Agdbentures, un jeu de pratique du débogage en C avec des niveaux conçus manuellement par des experts, en difficulté progressive, où chaque niveau est un mini-jeu visuel piloté par {GDB}. Un test avec 7 étudiants volontaires montre un bon engagement, malgré des problèmes d'interface identifiés.
Partie 4 — {EasytrackerDéveloppement} en parallèle d'une bibliothèque Python d'instrumentation de code (compatible Python natif et tout langage supporté par {GDB}), utilisée pour construire Agdbentures et divers outils pédagogiques (diagrammes pile/tas, visualiseur {RISC}-V, arbre d'appels récursifs).


Comment cette thèse caractérise la similarité
Contrairement aux autres références, la similarité n'est jamais l'objet central de ce travail — mais elle apparaît à trois endroits, de façon révélatrice sur ce qu'un chercheur en programmation éducative considère "par défaut" comme un signal de proximité :
1. Similarité par corrélation de performance Dans la section sur Compute-{IT}, l'auteur mesure si deux niveaux sont liés en calculant la corrélation de Spearman entre les résultats des élèves (nombre d'essais, temps de résolution) sur ces deux niveaux. C'est exactement le même paradigme que les papiers de similarité par performance vus précédemment : deux exercices sont "proches" si les mêmes élèves réussissent ou échouent dessus de façon corrélée — aucun regard sur le contenu. Résultat notable : cette corrélation ne suit pas l'introduction de nouveaux concepts comme attendu, ce qui l'amène à conclure que ce signal est peu fiable seul.
2. Similarité comme sous-produit de la factorisation matricielle (signatures latentes)Section 1.3.3 ("Student or Problem Prediction Kernels") : l'auteur évoque explicitement l'idée d'utiliser les signatures d'exercices produites par la factorisation matricielle (des vecteurs latents de dimension k) pour faire du clustering ou définir une mesure de similarité entre exercices, avec l'idée de "trouver un sous-ensemble d'exercices similaires à un sous-ensemble à haute précision de prédiction". Mais il précise que les essais de clustering sur ces signatures n'étaient "pas prometteurs" et que ces vecteurs latents ne sont probablement pas appropriés pour ce genre d'étude
— un signal négatif : la similarité dérivée d'un modèle de prédiction de performance (plutôt que construite directement sur le contenu) ne fonctionne pas bien ici.
Pertinence pour mon {projetArgument} de prudence méthodologique (les approches statistiques échouent sans structure pédagogique explicite, ce que les métadonnées analyse.md apportent) et contre-exemple utile : seule référence qui teste puis rejette une similarité dérivée d'un modèle de performance plutôt que du contenu.


},
 annotation = {Téléchargé le 30/06/2026 pour recherche sur ce qu’est la similarité entre exercice
},
 file = {HAL PDF Full Text:files/72/Barollet - 2023 - Apprentissage de la programmation par les problèmes  génération automatique d'exercices et recomman.pdf:application/pdf},
}

@inproceedings{liu_finding_2018,
 location = {New York, {NY}, {USA}},
 title = {Finding Similar Exercises in Online Education Systems},
 isbn = {978-1-4503-5552-0},
 url = {https://dl.acm.org/doi/10.1145/3219819.3219960},
 doi = {10.1145/3219819.3219960},
 series = {{KDD} '18},
 abstract = {In online education systems, finding similar exercises is a fundamental task of many applications, such as exercise retrieval and student modeling. Several approaches have been proposed for this task by simply using the specific textual content (e.g. the same knowledge concepts or the similar words) in exercises. However, the problem of how to systematically exploit the rich semantic information embedded in multiple heterogenous data (e.g. texts and images) to precisely retrieve similar exercises remains pretty much open. To this end, in this paper, we develop a novel Multimodal Attention-based Neural Network ({MANN}) framework for finding similar exercises in large-scale online education systems by learning a unified semantic representation from the heterogenous data. In {MANN}, given exercises with texts, images and knowledge concepts, we first apply a convolutional neural network to extract image representations and use an embedding layer for representing concepts. Then, we design an attention-based long short-term memory network to learn a unified semantic representation of each exercise in a multimodal way. Here, two attention strategies are proposed to capture the associations of texts and images, texts and knowledge concepts, respectively. Moreover, with a Similarity Attention, the similar parts in each exercise pair are also measured. Finally, we develop a pairwise training strategy for returning similar exercises. Extensive experimental results on real-world data clearly validate the effectiveness and the interpretation power of {MANN}.},
 pages = {1821--1830},
 booktitle = {Proceedings of the 24th {ACM} {SIGKDD} International Conference on Knowledge Discovery \& Data Mining},
 publisher = {Association for Computing Machinery},
 author = {Liu, Qi and Huang, Zai and Huang, Zhenya and Liu, Chuanren and Chen, Enhong and Su, Yu and Hu, Guoping},
 urldate = {2026-06-30},
 date = {2018},
 annotation = {{ProblématiqueDans} les systèmes d'éducation en ligne à grande échelle (1,4 million d'exercices dans cette étude), trouver des exercices similaires est une tâche fondamentale pour la recommandation et le suivi des élèves. Les méthodes existantes se basent principalement sur le texte ou les concepts partagés, mais ignorent les images (schémas, figures géométriques), qui représentent pourtant une part importante de l'information dans les exercices scientifiques (75 \% des exercices du dataset contiennent au moins une image).
Jeu de données1 420 727 exercices de mathématiques, dont 104 515 annotés par des experts avec leurs exercices similaires, donnant 401 476 paires similaires après consensus entre experts. Chaque exercice compte en moyenne 1,61 concept et 3,04 images.
Méthode proposée : {MANN} (Multimodal Attention-based Neural Network)Le modèle combine trois types de données pour chaque exercice — texte, images et concepts — en une seule représentation dense, grâce à un réseau {LSTM} enrichi de deux mécanismes d'attention : l'un relie chaque mot du texte aux concepts pertinents, l'autre aux images pertinentes. Une seconde couche d'attention (Similarity Attention) compare ensuite deux exercices en mettant en correspondance leurs mots respectifs, ce qui permet d'identifier les parties du texte sémantiquement équivalentes même en cas de formulation différente. Un score final de similarité entre 0 et 1 est produit par un petit réseau de neurones.
{EntraînementLe} modèle est entraîné avec une fonction de perte de type ranking par marge : pour un exercice donné, le score avec un exercice similaire (labellisé par un expert) doit dépasser celui avec un exercice non-similaire d'une marge minimale. Les négatifs sont échantillonnés soit aléatoirement, soit en priorité parmi les exercices partageant au moins un concept avec l'exercice de référence — cette seconde stratégie s'avère nettement plus efficace, car elle force le modèle à apprendre des distinctions fines plutôt que des différences triviales.
{RésultatsMANN} surpasse toutes les méthodes de comparaison ({VSM}/{TF}-{IDF}, {LSTM}, {ABCNN}, modèles multimodaux {CNN}), avec jusqu'à 39 \% d'amélioration en précision au Top-1 par rapport au meilleur concurrent basé uniquement sur le texte. L'étude d'ablation confirme la contribution de chaque composant (texte, images, concepts, mécanismes d'attention).
Limites et perspectives évoquées par les {auteursLes} auteurs mentionnent explicitement vouloir intégrer la difficulté des exercices dans de futurs travaux, développer des méthodes semi-supervisées pour réduire le besoin d'annotation manuelle, et étendre l'approche à d'autres disciplines.
Pertinence pour le  {projetDeux} apports directement exploitables : (1) la stratégie d'échantillonnage des paires négatives par concepts partagés plutôt qu'aléatoire, transposable à ma génération de paires close/medium/distant pour affiner l'entraînement de {SBERT} par exemple ; (2) la démonstration chiffrée que la similarité de concepts seule est peu discriminante à grande échelle (plus de la moitié des exercices labellisés partagent leurs concepts avec au moins 1000 autres exercices), ce qui renforce l'argument  de l’aproche de Dominique ,approche multi-signaux combinant similarité sémantique, concepts, prérequis, difficulté et niveau Bloom.

Comment ils caractérisent  concrètement la similarité,
la similarité est le jugement humain d'un expert ("cet exercice a le même objectif pédagogique que celui-là"), traitée comme un label binaire (similaire / non-similaire) plutôt qu'un score continu. Le modèle n'apprend pas à prédire "à quel point" deux exercices sont proches sur une échelle — il apprend seulement à classer un score plus haut qu'un autre (le similaire doit dépasser le non-similaire d'une marge). C'est une similarité relative et comparative, pas absolue.
},
 annotation = {Téléchargé le 30/06/2026 pour recherche sur ce qu’est la similarité entre exercice
A {GRATTER} : “« Mueller et al. [25] utilized a {LSTM} architecture to extract semantic representations for analyzing the similarity relations of sentences in pairs. Yin et al. [43] » (Liu et al., 2018, p. 1823)”
A lire et faire une synthèse.
},
 file = {Full Text PDF:files/74/Liu et al. - 2018 - Finding Similar Exercises in Online Education Systems.pdf:application/pdf},
}

@article{xiang_graph_2024,
 title = {Graph semantic similarity-based automatic assessment for programming exercises},
 volume = {14},
 rights = {2024 The Author(s)},
 issn = {2045-2322},
 url = {https://www.nature.com/articles/s41598-024-61219-8},
 doi = {10.1038/s41598-024-61219-8},
 abstract = {This paper proposes an algorithm for the automatic assessment of programming exercises. The algorithm assigns assessment scores based on the program dependency graph structure and the program semantic similarity, but does not actually need to run the student’s program. By calculating the node similarity between the student’s program and the teacher’s reference programs in terms of structure and program semantics, a similarity matrix is generated and the optimal similarity node path of this matrix is identified. The proposed algorithm achieves improved computational efficiency, with a time complexity of \$\$O(n{\textasciicircum}2)\$\$for a graph with n nodes. The experimental results show that the assessment algorithm proposed in this paper is more reliable and accurate than several comparison algorithms, and can be used for scoring programming exercises in C/C++, Java, Python, and other languages.},
 pages = {10530},
 number = {1},
 journaltitle = {Scientific Reports},
 shortjournal = {Sci Rep},
 publisher = {Nature Publishing Group},
 author = {Xiang, Chengguan and Wang, Ying and Zhou, Qiyun and Yu, Zhen},
 urldate = {2026-06-30},
 date = {2024-05-08},
 langid = {english},
 keywords = {Computer science, Software},
 annotation = {Note de Lecture

But Principal
Le papier propose une méthode d’évaluation d’exercices de programation sans run  le code de l’étudiant  (Peu etre utile a la plateforme Planton pour l’évaluation des exercices de manier dynamique ) en calculant la similarité entre le code de l’etudiant et le code solution de réference (ce qui rejoins d’une facon ou d’une autre notre besoin de pouvoir exprimé la similitude entre deux codes  donné et il s’agit d’une similarité sémantique et peut etre utilisé dans plusieurs langage comme C/C++,Java,Python,…)

Ce qui se faisait avant (L'Existant \& ses limites)


La méthode : L'évaluation dynamique basée sur les jeux de tests (Test-case based grading). Le système compile le code de l'étudiant et l'exécute face à une série de scénarios prédéfinis pour vérifier si la sortie (output) est correcte.


Les limites :


Superficiel : Évalue uniquement le résultat final, ignorant totalement la logique, l'algorithmique et la structure du code.


Binaire : Un code logiquement brillant mais qui a une erreur de formatage d'affichage échouera aux tests.


Coûteux : Oblige l'enseignant à écrire des batteries de tests exhaustives (edge cases) pour chaque exercice.




La différence apportée (La Valeur ajoutée)


Le changement de paradigme : Le papier met en évidence le passage d'une évaluation par l'exécution à une évaluation par l'analyse sémantique statique.


L'apport majeur : Le système est désormais capable de "comprendre" l'intention algorithmique. Il peut accorder des points à un étudiant qui a la bonne logique (la même que la solution de référence), même s'il utilise des structures de contrôle différentes ou s'il y a un bug d'exécution mineur. Cela permet de mimer la notation humaine (qui donne des points partiels pour la logique).


3. Comment ça fonctionne concrètement ? (La Mécanique) Pour s'affranchir de l'exécution, les nouvelles méthodes procèdent en 3 étapes :
1.Modélisation Graphique (Abstraction) : Le code brut n'est pas lu comme du simple texte. Il est transformé en structures mathématiques :
{AST} (Abstract Syntax Tree) : Pour cartographier la grammaire du code ils utilisent {SrcML} ungénérateur {AST} en {XML} opensource .
2. Standardisation de l’{AST}:
 forcé le modèle à ne comparer que l'ossature logique et conceptuelle des exercices affin de rendre deux code qui fais la meme chose identique exemple x+=1 et x++ en X=X+1 simplement ou encore declaration sur une ligne  .
Vu que le {AST} est en {XML} il est facilement sparsable pour cette  standardisation.


3.{CFG} (Control Flow Graph) / {SDG} (System Dependence Graph) :
 Pour tracer le chemin d'exécution et la dépendance entre les variables.(Qui etait l’une des premieres idéés au début d’aileurs )


Vectorisation par Deep Learning (Embeddings) : Des modèles de langage spécialisés dans le code (comme {CodeBERT} ou {CodeT}5) "ingèrent" ces graphes et traduisent la sémantique du programme en un vecteur dense (une suite de nombres dans un espace multidimensionnel).


Calcul de Distance : Le système génère le vecteur du code étudiant et le vecteur du code de référence (le corrigé du prof). Il calcule ensuite la distance mathématique (similarité cosinus, modèles de régression comme Random Forest) entre ces deux vecteurs. Plus ils sont proches dans l'espace vectoriel, plus la note est élevée.


Lien avec le projet
 Cette mécanique de "traduction en vecteur" -{\textgreater} "calcul de distance statique" est exactement celle qui permet d'abandonner l'évaluation dynamique. Si cette distance sert ici à noter un étudiant par rapport à un corrigé, elle peut tout à fait être réutilisée pour calculer la proximité conceptuelle entre deux corrigés d'exercices différents afin de les lier dans un graphe pédagogique.





},
 annotation = {Téléchargé le 30/06/2026 pour recherche sur ce qu’est la similarité entre exercice
},
 file = {Full Text PDF:files/78/Xiang et al. - 2024 - Graph semantic similarity-based automatic assessment for programming exercises.pdf:application/pdf},
}

@inproceedings{tian_automated_2022,
 title = {Automated Matching of Exercises with Knowledge components.},
 booktitle = {{ICCE}},
 author = {Tian, Zejie and Flanagan, Brendan and Dai, Yiling and Ogata, Hiroaki},
 date = {2022},
 annotation = {Objectif : Faire correspondre automatiquement des exercices de mathématiques (collège japonais) à des knowledge components ({KC}), pour réduire le temps d'annotation manuelle par des experts.
{ProblématiqueDans} les collèges japonais, chaque exercice de mathématiques doit être associé à un ou plusieurs « knowledge components » ({KC}) — l'équivalent des compétences ou concepts qu'il mobilise (ex. factorisation, addition d'entiers). Cette annotation est aujourd'hui réalisée manuellement par des enseignants, ce qui est coûteux en temps. Les auteurs proposent un modèle capable de suggérer automatiquement les bons {KC} pour un exercice donné, afin que l'expert n'ait plus qu'à valider rapidement plutôt qu'à annoter de zéro.
Jeu de données
830 exercices de mathématiques de collège, chacun déjà annoté manuellement avec un ou plusieurs {KC} parmi 13 possibles. Ce jeu de données annoté sert à la fois à entraîner le modèle de classification final et à évaluer ses performances (vérité terrain).
Les exercices sont initialement passe par une phase de nettoyage pour ne garder que les mots porteurs de sens.
Ensuite il commence une premiere approche :
comprendre le sens général du texte (word embedding) :Chaque mot est transformé en un vecteur numérique de 300 dimensions grâce à {FastText}, une méthode de la famille Word2Vec
Son principe : le modèle apprend à prédire un mot à partir des mots qui l'entourent dans une phrase (ou inversement), de sorte que des mots employés dans des contextes similaires — par exemple « addition » et « soustraction » — se retrouvent avec des vecteurs numériques proches, sans qu'aucune notion de {KC} n'intervienne à ce stade.
Ensuite Seconde approche —
repérer les concepts mathématiques précis (keyphrase extraction) :
En parallèle, les auteurs ont constitué une liste de concepts mathématiques clés à partir des manuels scolaires (ex. « factorisation », « polynôme »). Pour chaque exercice, ils détectent lesquels de ces concepts apparaissent dans le texte.ces concepts mathématiques servent d'indices pour deviner le bon {KC}.
Fusion de deux approches ,chaque méthode produit, pour un exercice donné, une estimation de probabilité d'appartenance à chacun des 13 {KC}. Les auteurs combinent ces deux estimations puis utilisent un modèle de classification
Résultat
Le modèle combiné surpasse nettement chacune des deux méthodes utilisées séparément, ainsi que plusieurs méthodes de comparaison classiques (similarité de texte simple, autres modèles d'apprentissage automatique standards). Quand le modèle propose ses trois meilleures suggestions de {KC} pour un exercice, la bonne réponse s'y trouve dans plus de 95 \% des cas.
Test avec des experts humains
Des experts ont été chronométrés en annotant des exercices avec et sans l'aide des suggestions du modèle. Les experts assistés allaient plus vite (6 minutes en moyenne contre 8 sans aide), et dans 84 \% des cas la première suggestion du modèle était la bonne — confirmant un gain de temps réel sans sacrifier la fiabilité.
Limites reconnues par les auteurs
Extraire le texte depuis des {PDF} fait perdre certaines informations, notamment les formules mathématiques mal capturées ; les schémas et figures des exercices de géométrie ne sont pas exploités ; le jeu de données reste de taille modeste (830 exercices), ce qui limite la portée des résultats.
},
 annotation = {Téléchargé le 30/06/2026 pour recherche sur ce qu’est la similarité entre exercice
},
 file = {PDF:files/83/Tian et al. - 2022 - Automated Matching of Exercises with Knowledge components..pdf:application/pdf},
}

@article{mu_bcrnet_2023,
 title = {{BCRNet}: Bidirectional contrastive representation network for deep multimodal learning of exercise representations in online education systems},
 volume = {548},
 issn = {09252312},
 url = {https://linkinghub.elsevier.com/retrieve/pii/S0925231223005325},
 doi = {10.1016/j.neucom.2023.126409},
 shorttitle = {{BCRNet}},
 abstract = {In online education systems, learning exercise representation is a fundamental task in many applications, such as exercise retrieval and recommendation. To capture the heterogeneous data information of exercises (i.e., texts and images), deep multimodal approaches show the promising performance. However, these methods have two limitations: (1) they only care about context on one side, which fails to utilize the future context chunks in the exercises; (2) they cannot ensure the presentation ability due to the scarcity of labelled data. In this paper, we propose a bidirectional contrastive representation network ({BCRNet}) to tackle these issues. First, we construct a representation module with a masking constraint loss to take into account the bidirectional context contents of exercises. Second, we design a contrastive learning approach which uses a multimodal contrastive loss to reshape the multimodal representation space and improve model presentation ability without labelled data. Moreover, a text-image matching strategy is designed to provide semantic links between texts and images. On the real-world dataset, experiments demonstrate {BCRNet} performs signiﬁcantly better than many strong baselines.},
 pages = {126409},
 journaltitle = {Neurocomputing},
 shortjournal = {Neurocomputing},
 author = {Mu, Jie and Zhang, Xianchao and Du, Yujiao and Hu, Yuxiang and Liu, Han and Xu, Jian},
 urldate = {2026-07-02},
 date = {2023-09},
 langid = {english},
 annotation = {Note de Lecture
Problème traité : apprendre des représentations d'exercices (texte + images) dans des systèmes d'éducation en ligne, pour la recherche et la recommandation d'exercices similaires, sans dépendre de données labellisées.
Deux limites identifiées dans les méthodes existantes :


Les modèles multimodaux antérieurs ({MANN}, {KnowNet}) utilisent une prédiction unidirectionnelle (gauche-à-droite), ce qui ignore le contexte à droite d'un mot.


Ils nécessitent des paires labellisées (exercices similaires/dissimilaires), coûteuses à produire car il faut une expertise pédagogique.



Solution proposée ({BCRNet}) — trois composants :


Module texte : génère à la fois un embedding "masqué" (façon {BERT}, pour capter le contexte bidirectionnel) et deux versions augmentées du texte .


Module image : deux versions augmentées de l'image (gaussian blur, color jitter), passées dans un {ResNet}.


Module de représentation : fusionne texte et image en un embedding multimodal unique, entraîné avec trois pertes combinées :


Perte contrastive multimodale ({InfoNCE}) : rapproche les deux vues augmentées d'un même exercice, éloigne les autres exercices du batch — c'est le cœur non-supervisé du modèle.


Perte de masquage : objectif auxiliaire pour forcer la compréhension bidirectionnelle du texte — ce n'est {PAS} une augmentation contrastive, c'est une perte séparée.


Perte de matching texte-image : classifie si une image correspond bien au texte de l'exercice.




Données et résultats : entraîné sur 200 000 exercices (44 154 images) tirés d'un corpus de 6 millions, chez Alibaba. Testé sur deux tâches (retrieval, clustering) avec seulement 3 classes grossières (rédaction, maths, raisonnement logique). {BCRNet} bat tous les baselines ({SimCSE}, {ConSERT}, {MANN}, {KnowNet}, etc.).

Ce que je retiens de cet article pour le  projet
Le schéma "deux vues augmentées → perte contrastive {InfoNCE}" me semble directement transposable à la fusion texte+code : on peut appliquer exactement le même principe (rapprocher deux vues d'un même exercice, éloigner les autres exercices du batch) des  paires énoncé+solution plutôt qu'à leurs paires texte+image.

},
 annotation = {Téléchargé le 02/07/2026   car traite de la  Similarité d'exercices sans paires labellisées (contrastif, alternative à {MANN}/{KnowNet})
},
 file = {PDF:files/86/Mu et al. - 2023 - BCRNet Bidirectional contrastive representation network for deep multimodal learning of exercise re.pdf:application/pdf},
}

@article{pelanek_measuring_2020,
 title = {Measuring Similarity of Educational Items: An Overview},
 volume = {13},
 issn = {1939-1382},
 url = {https://ieeexplore.ieee.org/document/8629958},
 doi = {10.1109/TLT.2019.2896086},
 shorttitle = {Measuring Similarity of Educational Items},
 abstract = {A measure of similarity of educational items has many applications in adaptive learning systems and can be useful also for teachers and content creators. We provide a thorough overview of approaches for measuring item similarity. We document the computation pipeline, explicitly highlighting many choices that have to be made in order to quantify item similarity. We also discuss methods for the analysis of similarity measures. For illustration and evaluation, we consider items from diverse domains, e.g., mathematics, programming, and language learning. Although there is no ultimate, universal approach to measuring item similarity, our overview leads to guidelines that facilitate computation of item similarity in practical applications.},
 pages = {354--366},
 number = {2},
 journaltitle = {{IEEE} Transactions on Learning Technologies},
 author = {Pelánek, Radek},
 urldate = {2026-07-03},
 date = {2020-04},
 keywords = {Atmospheric measurements, Clustering algorithms, Natural languages, Particle measurements, Pipelines},
 annotation = {Note de Lecture

Résumé
Cet article propose une revue complète des méthodes de mesure de similarité entre exercices pédagogiques ("educational items"), en montrant que cette notion est multidimensionnelle et dépend fortement des données disponibles ainsi que de l'application visée. L'auteur explique qu'il n'existe pas de mesure universelle de similarité : celle-ci peut être calculée à partir de l'énoncé, des métadonnées, des solutions, ou encore des performances des apprenants. Le choix de la représentation des exercices constitue l'étape la plus importante du pipeline de calcul de similarité.

L'article distingue deux grandes familles d'approches :


les approches basées sur le contenu (content-based), qui exploitent les caractéristiques intrinsèques des exercices (texte, mots-clés, solutions, métadonnées) ;


les approches basées sur les données d'apprentissage (performance-based), qui utilisent les réponses, le temps de résolution ou les erreurs des apprenants.



Il formalise le calcul de similarité comme une succession d'étapes comprenant :


le choix des données d'entrée ;


l'extraction d'une représentation (feature matrix) ;


le calcul d'une matrice de similarité ;


son exploitation pour le clustering, la visualisation ou la recommandation.


Méthodes détaillées par type de donnée
Contenu (énoncé/solution) : deux stratégies possibles — passer par une matrice de features (bag-of-words, mots-clés spécifiques au domaine : opérateurs mathématiques, mots-clés de code) puis calculer une similarité dessus (cosinus, corrélation, distance euclidienne) ; ou calculer directement une similarité par distance d'édition (Levenshtein pour le texte, distance d'édition d'arbre pour les structures syntaxiques comme le code ou les expressions mathématiques).
Le papier reste essentiellement au niveau lexical/syntaxique pour le code (mots-clés, structure d'arbre)
Performance des apprenants : à partir d'une matrice apprenants × items (réponses correctes/incorrectes), l'auteur compare 6 mesures d'accord binaire — Pearson/Phi, Yule, Cohen (kappa), Ochiai (= cosinus sur données binaires), Sokal, Jaccard. Résultat empirique clé : Pearson, Yule et Cohen donnent de bien meilleurs résultats que Ochiai, Sokal et Jaccard, à la fois sur données simulées et réelles. Sokal en particulier reste médiocre même avec plus de données — le problème n'est pas le manque de données mais la mesure elle-même.

Les similarités calculées à partir de sources différentes (énoncé texte, solution code, performance apprenants) sont faiblement corrélées entre elles — chaque source capture un aspect distinct et aucune ne fait référence. C'est l'argument le plus réutilisable de l'article : il justifie empiriquement de fusionner plusieurs modalités plutôt que de trancher pour une seule.
Second niveau de similarité  — piste de post-traitement
Au lieu de comparer directement deux items i et j, on compare leurs profils de similarité complets (leurs lignes dans la matrice déjà calculée) via corrélation ou distance euclidienne. Deux items peuvent ainsi être jugés proches même sans lien direct fort, s'ils sont chacun proches des mêmes items tiers
Limites méthodologiques à retenir
Pour un démarage a froid : 500 réponses/apprenant nécessaires pour une mesure de performance stable — non applicable chez nous (pas de données de performance sur le corpus institutionnel), ce qui renforce le choix de s'appuyer sur le contenu (texte+code)
Pas de vérité terrain absolue


},
 annotation = {Téléchargé en date du 03/07/2026. Cet article est cité par les auteurs de l’article “{BCRNet}: Bidirectional contrastive representation network for deep multimodal learning of exercise representations in online education systems”
Page de l’auteur sur la revue https://ieeexplore.ieee.org/author/37088425779
Sa page Scholar : https://scholar.google.fr/citations?user=Q5pgzoUAAAAJ\&hl=fr\&oi=ao

},
 file = {Full Text PDF:files/91/Pelánek - 2020 - Measuring Similarity of Educational Items An Overview.pdf:application/pdf},
}

@inproceedings{jolivet_modelisation_2025,
 location = {Lille, France},
 title = {Modélisation et décision de rétroactions épistémiques dans l'environnement {AlgoPython}},
 url = {https://hal.science/hal-05163937},
 abstract = {{AlgoPython} est une plateforme d'apprentissage de la programmation en Python. Dans sa version actuelle elle propose des rétroactions limitées aux erreurs syntaxiques et à la validation de la tâche. Dans cet article nous étudions  les différents éléments nécessaires à la mise en place d'un système de décision de rétroactions épistémiques adaptées à l'apprenant. Après avoir présenté le problème de la décision des rétroactions, nous analysons un algorithme de type {\textbackslash}emph\{Reinforcement learning\} pour l'aborder. Nous définissons alors deux éléments fondamentaux : la définition des éléments à prendre en compte pour permettre la décision (éléments relatifs à l'apprenant et à sa production) et la modélisation et la production des rétroactions. Enfin nous proposons une première preuve de concept permettant d'évaluer la production des rétroactions ainsi que le choix d'un algorithme de type {\textbackslash}emph\{Reinforcement learning\} pour la décision de rétroactions.},
 booktitle = {Environnements Informatiques pour l'Apprentissage Humain},
 publisher = {Université de Lille},
 author = {Jolivet, Sébastien and Kirouchenassamy, Badmavasan and Yessad, Amel and Luengo, Vanda},
 urldate = {2026-07-07},
 date = {2025-06},
 keywords = {Apprentissage de la programmation, Apprentissage par renforcement, Décision des feedbacks, Rétroactions épistémiques},
 annotation = {Note de lecture en date du 21/08/2026 :
Cet article à pour objectif principal de proposer et de tester un système d’approche par renforcement, dans un {EIAH} d’apprentissage de la programmation python, pour fournir à un apprenant un retour (dit rétroaction) pour assister son apprentissage de la programmation python.
Ce projet est dans le domaine de la didactique, l’idée est de détecter les erreurs de l’apprenant, de créer des profils type (liées aux erreurs sous la forme d’un vecteur et d’un poids normalement le nombre d’erreurs) et d’utiliser des rétroactions adaptées aux erreurs de l’apprenant ainsi qu’a son profil …
L’important dans cet article n’est pas du tout le cadre épistémique, didactique etc {MAIS} le fait qu’ils utilise une comparaison d’{AST} pour détecter des erreurs entre un {AST} bugué et un {AST} correct. Pour ce faire ils ont modifié, renforcer l’algorithme de Zhang-Shasha.
