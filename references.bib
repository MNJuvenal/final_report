 keywords = {Computer Science - Machine Learning, Computer Science - Programming Languages, Statistics - Machine Learning},
 annotation = {Télecharger pour comprendre l’amélioration de {AST} → Embeddings introduit dans le paier de code2vec

},
 file = {PDF:files/51/Alon et al. - 2019 - code2seq Generating Sequences from Structured Representations of Code.pdf:application/pdf},
