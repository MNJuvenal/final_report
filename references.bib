@inproceedings{hakim_automated_2014,
 location = {Yogyakarta, Indonesia},
 title = {Automated document classification for news article in Bahasa Indonesia based on term frequency inverse document frequency ({TF}-{IDF}) approach},
 isbn = {978-1-4799-5303-5 978-1-4799-5302-8 978-1-4799-5301-1},
 url = {http://ieeexplore.ieee.org/document/7007894/},
 doi = {10.1109/ICITEED.2014.7007894},
 abstract = {The exponential growth of the data may lead us to the information explosion era, an era where most of the data cannot be managed easily. Text mining study is believed to prevent the world from entering that era. One of the text mining studies that may prevent the explosion era is text classification. It is a way to classify articles into several predefined categories. In this research, the classifier implements {TF}-{IDF} algorithm. {TF}-{IDF} is an algorithm that counts the word weight by considering frequency of the word ({TF}) and in how many files the word can be found ({IDF}). Since the {IDF} could see the in how many files a term can be found, it can control the weight of each word. When a word can be found in so many files, it will be considered as an unimportant word. {TF}-{IDF} has been proven to create a classifier that could classify news articles in Bahasa Indonesia in a high accuracy; 98.3 \%.},
 eventtitle = {2014 6th International Conference on Information Technology and Electrical Engineering ({ICITEE})},
 pages = {1--4},
 booktitle = {2014 6th International Conference on Information Technology and Electrical Engineering ({ICITEE})},
 publisher = {{IEEE}},
 author = {Hakim, Ari Aulia and Erwin, Alva and Eng, Kho I and Galinium, Maulahikmah and Muliady, Wahyu},
 urldate = {2026-06-18},
 date = {2014-10},
 langid = {english},
 annotation = {Pour bien comprendre comment le système traite le texte et où se situent les goulots d'étranglement ou les risques d'erreur, voici le détail des étapes de préparation (pré-traitement) et de calcul (A à G) mises en place par les chercheurs avant même de pouvoir classifier un document.
A. La Tokenisation (Découpage en lexèmes) C'est la première étape de préparation. L'ordinateur prend le texte brut, supprime toute la ponctuation (car elle ne représente aucune catégorie) et segmente les phrases mot par mot. Par exemple, la phrase "This paper divided into 6 parts." devient une simple liste : [This] [paper] [divided] [into] [six] [parts].
B. Création de Bigrammes (Paires de mots) Pour enrichir le dictionnaire et améliorer la précision, le système ne se contente pas de mots isolés. Il va associer chaque mot avec le mot suivant (mot d'index n avec le mot d'index n+1) pour créer des expressions composées. La liste précédente génère alors de nouveaux termes : [This paper] [paper divided] [divided into].
C. Suppression des doublons (Duplicate Removal) Une fois la liste de mots et de bigrammes créée, le système supprime tous les doublons stricts dans le lexique global. L'objectif est d'alléger la base de données pour réduire le temps de calcul lors des étapes suivantes.
D. Suppression des mots vides (Stop Word Removal) Le système utilise un dictionnaire externe (téléchargé gratuitement sur internet) pour identifier et supprimer les mots de liaison, les prépositions et les pronoms (comme "the", "a", "an" en anglais, ou "yang", "di" en indonésien). Ces mots n'ont pas de sens sémantique propre et alourdissent inutilement les calculs.
E. Filtrage par fréquence (Term Frequency Filtering) C'est une étape radicale pour réduire la dimension de la matrice de calcul. Les chercheurs ont fixé un seuil d'apparition à 200. Tout mot ou bigramme qui apparaît moins de 200 fois dans l'ensemble de leur base de données de 7 500 articles est purement et simplement supprimé.
F. Suppression supervisée (Supervised Word Removal) C'est ici que l'on comprend l'une des grandes faiblesses du processus. La création de bigrammes à l'étape B génère énormément de paires de mots invalides ou qui n'ont aucun sens. Les chercheurs expliquent qu'ils ont dû vérifier le lexique manuellement pour supprimer ces mots invalides résiduels, ce qui prouve que le système n'est pas 100 \% autonome et nécessite une intervention humaine pour rester fiable.
G. Implémentation du calcul {TF}-{IDF} Une fois que le dictionnaire est parfaitement nettoyé (étapes A à F), l'algorithme mathématique entre enfin en jeu. Pour chaque mot restant, il calcule son poids final via la formule
tfidf(t,d,D) = tf(t,d) X idf(t,D.
 Il multiplie la fréquence du mot dans le document ({TF}) par un score logarithmique qui évalue sa rareté globale dans tous les documents ({IDF}).
Note supplémentaire : L'article mentionne une étape H. Normalisation. Comme les articles n'ont pas la même longueur, le score calculé à l'étape G est normalisé sur une échelle de 0 à 1 pour que tous les textes puissent être comparés équitablement.
},
 file = {PDF:files/35/Hakim et al. - 2014 - Automated document classification for news article in Bahasa Indonesia based on term frequency inver.pdf:application/pdf},
}

@article{salton_vector_1975,
 title = {A vector space model for automatic indexing},
 volume = {18},
 issn = {0001-0782, 1557-7317},
 url = {https://dl.acm.org/doi/10.1145/361219.361220},
 doi = {10.1145/361219.361220},
 abstract = {In a document retrieval, or other pattern matching environment where stored entities (documents) are compared with each other or with incoming patterns (search requests), it appears that the best indexing (property) space is one where each entity lies as far away from the others as possible; in these circumstances the value of an indexing system may be expressible as a function of the density of the object space; in particular, retrieval performance may correlate inversely with space density. An approach based on space density computations is used to choose an optimum indexing vocabulary for a collection of documents. Typical evaluation results are shown, demonstating the usefulness of the model.},
 pages = {613--620},
 number = {11},
 journaltitle = {Communications of the {ACM}},
 shortjournal = {Commun. {ACM}},
 author = {Salton, G. and Wong, A. and Yang, C. S.},
 urldate = {2026-06-18},
 date = {1975-11},
 langid = {english},
 annotation = {papier qui tratraite de la base de {TF}-{IDF}

L'idée de base : Les documents sont des points dans l'espace on peu l’imaginez comme  un espace en 3D (ou plus). L'algorithme transforme chaque document (ou chaque énoncé d'exercice) en un simple "point" géométrique dans cet espace.


Si deux énoncés partagent beaucoup de mots, leurs points sont placés très près l'un de l'autre.


S'ils n'ont aucun mot en commun, ils sont placés très loin.


1. La grande découverte : L'importance de "l'espacement" La trouvaille majeure des chercheurs est très intuitive : pour qu'un moteur de recherche soit performant, il faut que les points soient le plus éloignés possible les uns des autres dans cet espace.


L'espace dense (mauvais) : Si tous les mots ont le même poids, tous les documents s'agglutinent au centre. Quand vous cherchez un document précis, l'algorithme vous ramène tout le tas agglutiné autour (beaucoup de mauvais résultats).


L'espace espacé (idéal) : Si on utilise des formules comme le {TF}-{IDF}, les documents s'éparpillent. Ainsi, quand l'algorithme cible une zone pour répondre à votre recherche, il ne ramasse que les quelques documents pertinents qui s'y trouvent, en ignorant le reste.


L'effet "Groupes" (Clusters) : Dans l'idéal, les documents qui parlent de la même chose doivent former un petit groupe très serré, mais ce groupe doit être situé extrêmement loin des autres groupes parlant d'autres sujets.


2. Le pouvoir des mots : Bons et mauvais "séparateurs" Les auteurs expliquent que chaque mot a une "valeur de discrimination", c'est-à-dire une capacité à écarter les documents les uns des autres.


Un "bon" mot agit comme un repoussoir : en l'ajoutant à l'algorithme, il force les documents à s'éloigner et "aère" l'espace.


Un "mauvais" mot agit comme un aimant : il relie trop de textes entre eux et les force à s'agglutiner et à créer de la confusion.


3. La règle d'or pour un vocabulaire parfait Les chercheurs ont étudié quels étaient ces bons et mauvais mots selon leur fréquence d'apparition, et en ont tiré une recette très claire :


Les mots de fréquence moyenne : Ce sont les meilleurs. Ils sont parfaits pour identifier un sujet et écartent bien les textes. Il faut les garder tels quels.


Les mots trop fréquents (ex: "programme", "langage") : Ils sont affreux (ce sont les fameux aimants) car ils apparaissent partout. La solution de l'article : collez-les ensemble pour créer des phrases ! Si vous remplacez "langage" par l'expression "langage de programmation", l'expression devient plus rare, et redevient un excellent mot de recherche.


Les mots trop rares : Ils ne sont pas très utiles car ils ne relient presque rien. La solution : utilisez un dictionnaire de synonymes (thésaurus) ! Regroupez tous ces mots rares qui veulent dire la même chose sous un seul mot-clé, ce qui augmentera sa fréquence et son utilité.


Bilan : En appliquant simplement ces règles (laisser les mots moyens, faire des expressions avec les mots trop fréquents, et utiliser des synonymes pour les mots rares), les chercheurs ont prouvé que la précision des algorithmes bondit de 18 \% à 50 \%. C'est la preuve qu'un algorithme comme {TF}-{IDF} ne donne de bons résultats que si on prépare intelligemment le texte qu'on lui donne à lire !
},
 file = {PDF:files/37/Salton et al. - 1975 - A vector space model for automatic indexing.pdf:application/pdf},
}

@inproceedings{reimers_sentence-bert_2019,
 location = {Hong Kong, China},
 title = {Sentence-{BERT}: Sentence Embeddings using Siamese {BERT}-Networks},
 url = {https://www.aclweb.org/anthology/D19-1410},
 doi = {10.18653/v1/D19-1410},
 shorttitle = {Sentence-{BERT}},
 abstract = {{BERT} (Devlin et al., 2018) and {RoBERTa} (Liu et al., 2019) has set a new state-of-the-art performance on sentence-pair regression tasks like semantic textual similarity ({STS}). However, it requires that both sentences are fed into the network, which causes a massive computational overhead: Finding the most similar pair in a collection of 10,000 sentences requires about 50 million inference computations ({\textasciitilde}65 hours) with {BERT}. The construction of {BERT} makes it unsuitable for semantic similarity search as well as for unsupervised tasks like clustering.},
 eventtitle = {Proceedings of the 2019 Conference on Empirical Methods in Natural Language Processing and the 9th International Joint Conference on Natural Language Processing ({EMNLP}-{IJCNLP})},
 pages = {3982--3992},
 booktitle = {Proceedings of the 2019 Conference on Empirical Methods in Natural Language Processing and the 9th International Joint Conference on Natural Language Processing ({EMNLP}-{IJCNLP})},
 publisher = {Association for Computational Linguistics},
 author = {Reimers, Nils and Gurevych, Iryna},
 urldate = {2026-06-19},
 date = {2019},
 langid = {english},
 annotation = {Sentence-{BERT} ({SBERT}) – Fonctionnement détaillé

{BERT} classique produit d'excellentes représentations textuelles mais n'est pas adapté à la comparaison massive de phrases. Pour comparer deux phrases, {BERT} doit recevoir simultanément :
[{CLS}] Phrase A [{SEP}] Phrase B
Le modèle doit être exécuté pour chaque paire de phrases. Pour une base contenant N phrases, le nombre de comparaisons devient rapidement prohibitif.
{SBERT} vise à produire un embedding indépendant pour chaque phrase afin que les comparaisons puissent être effectuées ultérieurement par simple similarité cosinus.
Architecture
{SBERT} repose sur une architecture siamoise (Siamese Network).
Deux phrases sont envoyées dans deux copies identiques du même modèle {BERT} :
Phrase A → {BERT} → Embedding A
Phrase B → {BERT} → Embedding B
Les deux réseaux partagent exactement les mêmes poids.
Le modèle apprend à rapprocher les embeddings des phrases similaires et à éloigner ceux des phrases différentes.
Production de l'embedding
Étape 1 : Tokenisation
Exemple :
"Trouver le maximum d'une liste"
↓
[{CLS}] Trouver le maximum d'une liste [{SEP}]
Chaque token est converti en vecteur.
Étape 2 : Passage dans le Transformer
Chaque couche Transformer applique :


Self-Attention


Feed Forward Network


Normalisation


Connexions résiduelles


Chaque token interagit avec tous les autres tokens de la phrase.
Étape 3 : Pooling
{BERT} produit un vecteur de 768 dimensions pour chaque token.
Exemple :
Token 1 → 768 dimensions
Token 2 → 768 dimensions
...
Token n → 768 dimensions
{SBERT} doit convertir cette matrice en un seul vecteur représentant la phrase.
Les auteurs évaluent :


{CLS} Pooling


Max Pooling


Mean Pooling


Le Mean Pooling donne généralement les meilleurs résultats.
Embedding final :
E = moyenne des embeddings de tous les tokens
Le résultat est un vecteur unique de dimension 768.
Entraînement
Le modèle est entraîné sur des paires de phrases annotées.
Exemple :
Phrase A :"Trouver la plus grande valeur"
Phrase B :"Calculer le maximum"
Score :4.8 / 5
L'objectif est de rapprocher leurs embeddings.
La fonction de perte pousse les phrases similaires à avoir un cosinus élevé et les phrases différentes à avoir un cosinus faible.
Similarité
Une fois entraîné :
Phrase → Embedding
Puis :
similarité = cosinus(Embedding A, Embedding B)
Cette étape est extrêmement rapide comparée à l'utilisation de {BERT} classique.
Limites
{SBERT} capture la sémantique textuelle mais n'a aucune connaissance directe de la structure algorithmique ou du code. Deux exercices pédagogiquement différents mais décrits avec un vocabulaire proche peuvent obtenir un score élevé.
Utilisation dans notre projet
{SBERT} est utilisé pour représenter les énoncés d'exercices sous forme d'embeddings sémantiques. Il permet de détecter des exercices formulés différemment mais portant sur des concepts proches. Il constitue la composante textuelle principale de notre système de recommandation.
},
 annotation = {Télechargé afin de comprendre en détail comment {SBERT} est utilisé pour représenter les énoncés d'exercices sous forme de vecteurs sémantiques afin de mesurer leur similarité pédagogique.
},
 file = {PDF:files/43/Reimers and Gurevych - 2019 - Sentence-BERT Sentence Embeddings using Siamese BERT-Networks.pdf:application/pdf},
}

@inproceedings{baxter_clone_1998,
 location = {Bethesda, {MD}, {USA}},
 title = {Clone detection using abstract syntax trees},
 isbn = {978-0-8186-8779-2},
 url = {http://ieeexplore.ieee.org/document/738528/},
 doi = {10.1109/ICSM.1998.738528},
 abstract = {Existing research suggests that a considerable fraction (5-10\%) of the source code of large-scale computer programs is duplicate code (“clones”). Detection and removal of such clones promises decreased software maintenance costs of possibly the same magnitude. Previous work was limited to detection of either nearmisses differing only in single lexems, or near misses only between complete functions. This paper presents simple and practical methods for detecting exact and near miss clones over arbitrary program fragments in program source code by using abstract syntax trees. Previous work also did not suggest practical means for removing detected clones. Since our methods operate in terms of the program structure, clones could be removed by mechanical methods producing in-lined procedures or standard preprocessor macros.},
 eventtitle = {Proceedings. International Conference on Software Maintenance},
 pages = {368--377},
 booktitle = {Proceedings. International Conference on Software Maintenance (Cat. No. 98CB36272)},
